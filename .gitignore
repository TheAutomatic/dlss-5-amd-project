# iMMERSE（Marty's Mods / Pascal Gilcher）RTGI 的本地移植素材 —— 只留本地，不进仓库。
# NOTICE.txt 是随附的第三方声明：「Proprietary and confidential」「Unauthorized copying
# of this file, via any medium is strictly prohibited」；同目录 *.hlsl 是它的 native
# adaptation，iMMERSE_*.rgba 是 iMMERSE 贴图的二进制转换。研究用，不随本项目分发。
# 2026-09-15：git rm -r --cached，磁盘保留。发布的包走 package-amd-presr/experimental_lighting
# （analysis/experimental-lighting/Lighting.hlsl 编译，自述「no translated effect code」），与此无关。
analysis/rtgi-native/

# 取证构建产物（DLL/日志/obj）—— 回滚用，只留本地，不进仓库
exports/review-s*/

# 本地构建输出（构建脚本 + 打包器用的目录），不进仓库
exports/build/

# analysis/build-release-local.cmd 的输出（OptiScaler.dll、obj、测试 exe、build.log）。
# *.dll/*.obj/*.lib 已被下面的全局规则盖住，但 build.log 和 amd_submission_state.exe
# 没有，`git add -A` 会扫进来。
exports/release-local/

