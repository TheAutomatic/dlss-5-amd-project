#!/bin/sh
# Two checks, both about files that must not reach the repository.
#
# 1. A staged NEW file that .gitignore excludes -- the signature of `git add -f`.
#    `git add -A` and `git add <dir>` have swept local-only files into commits
#    three times in this repository; .gitignore now whitelists exports/ to stop
#    that, and this stops the bypass. Adding such a path on purpose is fine, but
#    un-ignore it in .gitignore first so the rule and the commit agree.
#
# 2. A staged PowerShell script that lost its UTF-8 BOM.
#
#    Windows PowerShell 5.1 decodes a BOM-less .ps1 with the system ANSI code
#    page (GBK on a Chinese Windows), so non-ASCII literals arrive mangled and
#    the file frequently fails to parse outright. The mark has gone missing three
#    times already, each time by a tool that read the file as utf-8-sig and wrote
#    it back as plain utf-8: the write succeeds silently and the damage only
#    shows when the script is finally run. One release shipped with a
#    浣跨敤璇存槑.txt - that is this bug, not a font problem.
#
#    Only scripts that actually contain non-ASCII bytes are checked; an
#    ASCII-only .ps1 is safe without the mark and is left alone.
#
# Usage:
#   .githooks/pre-commit              # check the staged set (normal, from git)
#   .githooks/pre-commit FILE...      # check these files by hand (check 2 only)
#
# Enable once per clone:  git config core.hooksPath .githooks

set -u

# --- 1. `git add -f` on an ignored path ------------------------------------
# --no-index is load-bearing: a path already in the index reports as NOT
# ignored, so without it a forced file looks clean and this never fires.
# quotePath=false on both sides keeps spaces and non-ASCII paths intact.
if [ "$#" -eq 0 ]; then
    forced=$(mktemp) || exit 0
    trap 'rm -f "$forced"' EXIT
    git -c core.quotePath=false diff --cached --name-only --diff-filter=A |
        git -c core.quotePath=false check-ignore --no-index --stdin > "$forced" 2>/dev/null || true

    if [ -s "$forced" ]; then
        cat >&2 <<'EOF'
pre-commit: 这些新文件被 .gitignore 排除，却被强行加进来了（用了 git add -f？）：

EOF
        sed 's/^/  /' "$forced" >&2
        cat >&2 <<'EOF'

它们多半是本机文件：日志、构建产物、只留本地的手稿。两条路——

  确实该进仓库 → 在 .gitignore 里加一行 `!<路径>` 放行，再重试
  本就不该进   → git restore --staged <路径>，再重试

本次提交已中止。
EOF
        exit 1
    fi
fi

# --- 2. a staged .ps1 that lost its UTF-8 BOM -------------------------------
list=$(mktemp) || exit 0
trap 'rm -f "$list"' EXIT

if [ "$#" -gt 0 ]; then
    printf '%s\n' "$@" > "$list"
else
    git diff --cached --name-only --diff-filter=ACM -- '*.ps1' '*.psm1' > "$list" || exit 0
fi

bad=$(mktemp) || exit 0
trap 'rm -f "$list" "$bad"' EXIT

while IFS= read -r f; do
    case "$f" in *.ps1|*.psm1) ;; *) continue ;; esac
    [ -f "$f" ] || continue
    # Already marked? Then nothing to do.
    [ "$(head -c3 "$f" | od -An -tx1 | tr -d ' \n')" = "efbbbf" ] && continue
    # No non-ASCII content? Then the mark is not load-bearing here.
    LC_ALL=C grep -q '[^ -~	]' "$f" 2>/dev/null || continue
    printf '  %s\n' "$f" >> "$bad"
done < "$list"

[ -s "$bad" ] || exit 0

cat >&2 <<'EOF'
pre-commit: 这些 .ps1 没有 UTF-8 BOM，但含有非 ASCII 字符：

EOF
cat "$bad" >&2
cat >&2 <<'EOF'

Windows PowerShell 5.1 会把无 BOM 的 .ps1 按系统 ANSI 代码页（GBK）解码，
中文字面量变乱码，脚本常常直接解析失败。补回来：

  printf '\xef\xbb\xbf' | cat - <文件> > /tmp/x && mv /tmp/x <文件>

（任何「按 utf-8-sig 读、按 utf-8 写」的工具都会静默删掉这个 BOM。
 若确实要让这个文件不带 BOM，请把它改成纯 ASCII 内容。）

本次提交已中止，补完 BOM 后重试即可。
EOF
exit 1
