#!/bin/sh
# Project policy: commit messages carry no co-author or session trailers.
# This is a git hook, so it applies on the real commit path whatever wrote the
# message; a tool-level setting only asks the tool not to add such lines.
f="$1"
[ -n "$f" ] && [ -f "$f" ] || exit 0

tmp="$f.trailer-strip"
grep -v -i -E '^Co-Authored-By:|^[A-Za-z]+-Session:' "$f" > "$tmp" 2>/dev/null || true
[ -s "$tmp" ] || { rm -f "$tmp"; exit 0; }
printf '%s\n' "$(cat "$tmp")" > "$f"
rm -f "$tmp"
exit 0
