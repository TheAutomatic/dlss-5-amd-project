// The D3D12 path's check at create (FASE10-D3D12-RUNTIME.md): every push constant dword reaches the kernel at its
// place (the first three, the ones read through the spill table by index, the last one) and so does the workgroup
// count. out[i] = k * i + mid[i % 57] + last + 65536 * groups.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "onr_common.glsl"
layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform P {
    U32Buf dst;
    uint k;
    uint mid[57];
    uint last;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    pc.dst.v[i] = pc.k * i + pc.mid[i % 57u] + pc.last + gl_NumWorkGroups.x * 65536u;
}
