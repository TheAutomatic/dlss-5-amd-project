#include <winver.h>
#include "opennr_rr_api.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ONR_RR_RUNTIME_VERSION_RC
PRODUCTVERSION ONR_RR_RUNTIME_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "OpenRR runtime"
            VALUE "FileVersion", ONR_RR_RUNTIME_VERSION
            VALUE "ProductName", "OpenRR"
            VALUE "ProductVersion", ONR_RR_RUNTIME_VERSION
            VALUE "LegalCopyright", "MIT"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
