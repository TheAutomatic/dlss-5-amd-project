#version 460
// Multi-pass, step 3 of 3: what the next pass is shown. Not this pass's
// answer as it is - every pass would then add the model's own tone
// compression and colour shift on top of the last, which is red skin and a
// picture a stop too dark by the third pass - but the FIRST pass's input with
// this pass's local structure on it: the luminance ratio with its low-pass
// removed (so the tone stays the input's), on the input's own hue. Each pass
// then adds detail and nothing else; tone and colour are applied once, by the
// transfer pass, from the first pass's answer.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D shown;           // shown_keep: the first pass's input
layout(set = 0, binding = 1, r32f) uniform image2D lograt;      // this pass's log ratio
layout(set = 0, binding = 2, r32f) uniform image2D lowpass;     // its blur
layout(set = 0, binding = 3, rgba32f) uniform image2D next_in;  // tex_in, written in place
layout(push_constant) uniform Push { uint width, height; float guard; } pc;
float srgb_decode(float x) { return x <= 0.04045 ? x / 12.92 : pow((x + 0.055) / 1.055, 2.4); }
float srgb_encode(float x) { return x <= 0.0031308 ? 12.92 * x : 1.055 * pow(x, 1.0 / 2.4) - 0.055; }
vec3 decode3(vec3 c) { c = clamp(c, vec3(0.0), vec3(1.0)); return vec3(srgb_decode(c.r), srgb_decode(c.g), srgb_decode(c.b)); }
vec3 encode3(vec3 c) { c = clamp(c, vec3(0.0), vec3(1.0)); return vec3(srgb_encode(c.r), srgb_encode(c.g), srgb_encode(c.b)); }
void main() {
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= int(pc.width) || xy.y >= int(pc.height)) return;
    const vec4 s = texelFetch(shown, xy, 0);
    const float detail = clamp(exp(imageLoad(lograt, xy).r - imageLoad(lowpass, xy).r), 1.0 / pc.guard, pc.guard);
    imageStore(next_in, xy, vec4(encode3(decode3(s.rgb) * detail), s.a));
}
