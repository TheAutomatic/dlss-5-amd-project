#version 460
#extension GL_GOOGLE_include_directive : require
// NR_WAVE_UNIFORM: tid/32 is one value per wave (a wave is 32
// consecutive invocations), but NIR sees a divergent value and keeps every
// quantity derived from it in VGPRs. Reading it through readfirstlane makes
// the same value scalar.
#ifndef NR_WAVE_UNIFORM
#define NR_WAVE_UNIFORM 0
#endif
#if NR_WAVE_UNIFORM
#extension GL_KHR_shader_subgroup_ballot : require
#define NR_WAVE_OF(t) subgroupBroadcastFirst((t) / 32u)
#else
#define NR_WAVE_OF(t) ((t) / 32u)
#endif
#include "coopmm.glsl"
#include "swin_math.glsl"
// e4m3 values are FP16 values here (coopmm.glsl).
#define fe4m3vec2 f16vec2
#define fe4m3vec4 f16vec4
#ifndef NR_STORE_ACC_COL
#define NR_STORE_ACC_COL(frag, arr, off, stride) \
    coopMatStore(frag, arr, (off), (stride), gl_CooperativeMatrixLayoutColumnMajor)
#endif
// FP32 CCSplitSwin16HFfwd, carried as [feature][token]. Weights are A
// operands and activations are B. On gfx11 an accumulator component is not
// a B operand component (an operand lane holds sixteen k values, an
// accumulator lane eight rows of one parity), so the quantised result of a
// stage reaches the next stage's B operand through a per-wave LDS tile: stored
// column-major, which is the arena's own tile format, and loaded back as B.
// Both intermediate e4m3 quantisations and the native half activation remain.
//
// Weights are FP16 tiles, 16x16 row-major [row][k] (A operand, stride 16).
// With NR_FFWD_PACK the tiles of two consecutive 16-row groups (rows 32j..32j+31)
// of one 16-wide k step are adjacent: element offset of the pair is
//   (row / 32) * (K / 16) * 512 + (k / 16) * 512, the second group 256 elements on.
//
// One subgroup owns one of eight groups and one 16-token tile. All groups
// run independently. The host supplies C=512 and a whole number of tiles.
#ifndef NR_ACC_F16
#define NR_ACC_F16 0
#endif
#if NR_ACC_F16 != 0
#error The transposed FFWD pipeline supports FP32 accumulation only
#endif
// Waves per workgroup. Each subgroup still owns one group and one
// 16-token tile; only how many groups share a workgroup changes, so small
// launches spread evenly over the WGPs. The host multiplies gx by 8/NR_FFWD_WGW.
#ifndef NR_FFWD_WGW
#define NR_FFWD_WGW 8
#endif
#if NR_FFWD_WGW != 1 && NR_FFWD_WGW != 2 && NR_FFWD_WGW != 4 && NR_FFWD_WGW != 8
#error "NR_FFWD_WGW must divide the eight groups"
#endif
layout(local_size_x = 32 * NR_FFWD_WGW) in;
layout(binding = 0, std430) NR_COH buffer ActF16 {
    NR_F16 act_f16[];
};
layout(binding = 1, std430) NR_COH buffer ActE4M3 {
    NR_E4M3 act_e4m3[];
};
layout(binding = 2, std430) NR_COH buffer ActF32 {
    float act_f32[];
};
layout(binding = 3, std430) readonly buffer WgtE4M3 {
    NR_E4M3 wgt_e4m3[];
};
layout(binding = 4, std430) readonly buffer WgtF16 {
    NR_F16 wgt_f16[];
};
layout(binding = 5, std430) NR_COH buffer ActE4M3x4 {
    fe4m3vec4 act_e4m3x4[];
};
#define NR_TC_WBIND 3   // NR_TCHAIN reads its records from the weight buffer
#include "nr_chain.glsl"
#include "occ_pad.glsl"
layout(push_constant) uniform Push {
    uint x_off, o_off, a_off, q0_off, q2_off, M, C;
    NR_CHAIN_FIELDS
    NR_TCHAIN_FIELDS
}
pc;
#define TILE(base, row, k, K) ((base) + ((row) / 16u) * ((K) / 16u) * 256u + ((k) / 16u) * 256u)
#if NR_FFWD_PACK
#define NR_FFWD_LOAD2(w0,w1,base,row,k,K) { \
    const uint nr_wi=(base) + ((row)/32u)*((K)/16u)*512u + ((k)/16u)*512u; \
    NR_LOAD_A(w0, wgt_e4m3, nr_wi, 16u); \
    NR_LOAD_A(w1, wgt_e4m3, nr_wi + 256u, 16u); }
#define S1_N(n) { \
    NR_FRAG_A w0,w1; \
    NR_FFWD_LOAD2(w0,w1,agrp,uint(n)*32u,k,pc.C) \
    NR_MMA(acc1[2*(n)],w0,x);NR_MMA(acc1[2*(n)+1],w1,x); }
#define NR_S1_ROWS 2
#else
#define S1_N(n)                                                                                    \
    {                                                                                              \
        NR_FRAG_A w;                                                                               \
        NR_LOAD_A(w, wgt_e4m3, TILE(agrp, uint(n) * 16u, k, pc.C), 16u);                           \
        NR_MMA(acc1[n], w, x);                                                                     \
    }
#define NR_S1_ROWS 4
#endif
#ifndef NR_FFWD_KOFF
#define NR_FFWD_KOFF 0
#endif
// diagnostic (wrong picture): NR_DIAG_FFWD_HALFW=1 reads every other weight pair of the
// FM=1 path twice (stage 1: k steps 2i and 2i+1; Q0/Q2: rows n and n+2), so half the weight loads
// fold away - an upper bound for any scheme that halves ffwd3's weight write-back.
#ifndef NR_DIAG_FFWD_HALFW
#define NR_DIAG_FFWD_HALFW 0
#endif
#if NR_DIAG_FFWD_HALFW
#define NR_DFW(i) ((i) & ~1)
#define NR_DFN(n) ((n) & 1u)
#define NR_DFK(k,n) ((n) == 2u ? ((k) ^ 1u) : (k))   // rows n+2 take row n's pair of the other k: no MMA chain repeats
#else
#define NR_DFW(i) (i)
#define NR_DFN(n) (n)
#define NR_DFK(k,n) (k)
#endif
#if NR_FFWD_KOFF && NR_FFWD_PACK
// Stage 1 with the chunk bases hoisted. Same fragments, same order: x is
// NR_LOAD_B's ColumnMajor stride-16 tile, and the weight pair is the one in
// NR_FFWD_LOAD2 with (k0 + 16i)/16 split as k0/16 + i.
#define S1_K(i)                                                                                    \
    {                                                                                              \
        NR_FRAG_B x;                                                                               \
        NR_LOAD_B(x, act_e4m3, xk + uint(i) * 256u, 16u);                                          \
        for (int n = 0; n < 2; ++n) {                                                              \
            const uint ix = (aw[n] + kw) + uint(NR_DFW(i)) * 512u;                                 \
            NR_FRAG_A w0, w1;                                                                      \
            NR_LOAD_A(w0, wgt_e4m3, ix, 16u);                                                      \
            NR_LOAD_A(w1, wgt_e4m3, ix + 256u, 16u);                                               \
            NR_MMA(acc1[2*n],w0,x); NR_MMA(acc1[2*n+1],w1,x);                                      \
        }                                                                                          \
    }
#else
#define S1_K(i)                                                                                    \
    {                                                                                              \
        uint k = k0 + uint(i) * 16u;                                                               \
        NR_FRAG_B x;                                                                               \
        NR_LOAD_B(x, act_e4m3, xbase + k * 16u, 16u);                                              \
        NR_FOR_J(NR_S1_ROWS, S1_N)                                                                          \
    }
#endif
// NR_FFWD_F32: the fused Swin family's arithmetic (NR_ACT_F32 with
// NR_ACT_HORNER, NR_QUANT_MODE 4's pair32): the cubic activation in f32 on the
// f32 accumulator and every e4m3 quantisation straight from f32, one rounding
// instead of the f16 hop's two. Not byte-identical; no lower-precision step.
#ifndef NR_FFWD_F32
#define NR_FFWD_F32 0
#endif
#if NR_FFWD_F32
float nr_ffwd_act32(float x) {
    const float t = clamp(x, -4.0, 4.0);
    const float u = fma(-0.055908203125, abs(t), 0.447265625);
    return x * fma(t, u, 0.89453125);
}
#endif
#if NR_FFWD_PAIR
fe4m3vec2 nr_ffwd_quant(f16vec2 v) {
#if NR_QUANT_MODE == 4
    return nr_quant_pair(v);
#else
    return nr_quant_pair(v);
#endif
}
#endif
#include "nr_prof.glsl"
// NR_FFWD_GMAJOR: group-major workgroups. The NR_FFWD_WGW subgroups of a
// workgroup share ONE weight group and take consecutive token tiles, so a
// group's 64K weights is fetched once into the CU's L0 for all of them
// instead of once per subgroup from L2 (the group-per-subgroup form made every
// subgroup of a workgroup read a different group). Same products, same k order
// per output; subgroups past the last tile return (no barriers here).
#ifndef NR_FFWD_GMAJOR
#define NR_FFWD_GMAJOR 0
#endif
#if NR_FFWD_GMAJOR
// NR_TCHAIN: the token tiles a workgroup reads (every wave's, before any returns).
#define NR_FFWD_T0(TT) (((gl_WorkGroupID.x / 8u) * NR_FFWD_WGW) * ((TT) / 16u))
#define NR_FFWD_NT(TT) (NR_FFWD_WGW * ((TT) / 16u))
#define NR_FFWD_MAP(TT) \
    uint group = gl_WorkGroupID.x % 8u, \
         tok = ((gl_WorkGroupID.x / 8u) * NR_FFWD_WGW + NR_WAVE_OF(gl_LocalInvocationID.x)) * (TT); \
    if (tok >= pc.M) return;
#else
#define NR_FFWD_T0(TT) ((gl_WorkGroupID.x / (8u / NR_FFWD_WGW)) * ((TT) / 16u))
#define NR_FFWD_NT(TT) ((TT) / 16u)
#define NR_FFWD_MAP(TT) \
    uint group = (gl_WorkGroupID.x % (8u / NR_FFWD_WGW)) * NR_FFWD_WGW + NR_WAVE_OF(gl_LocalInvocationID.x), \
         tok = (gl_WorkGroupID.x / (8u / NR_FFWD_WGW)) * (TT);
#endif
// NR_FFWD_FM=2: one subgroup owns one group and TWO 16-token tiles, so every
// weight fragment feeds two MMAs instead of one (the layer loads 64K
// weights a group and tile, and those loads' VGPR write-back costs SIMD
// cycles). Per output the same products in the same k order; the host
// launches half the tiles. An odd tile count leaves the last subgroup's second
// tile outside the tensor: it is computed from whatever lies there and not
// stored.
#ifndef NR_FFWD_FM
#define NR_FFWD_FM 1
#endif
#ifndef NR_FFWD_TPW
#define NR_FFWD_TPW 4
#endif
// Per-wave LDS tiles carrying a stage's quantised accumulators to the next stage's B
// operands: one 256-element tile per fragment, reused by the next stage once the
// fragments are in registers. FM=3 exchanges between waves and has its own arrays.
#if NR_FFWD_FM == 1
#define NR_FFWD_XSLOTS 4
#elif NR_FFWD_FM == 2
#define NR_FFWD_XSLOTS 8
#elif NR_FFWD_FM == 4
#define NR_FFWD_XSLOTS (4 * NR_FFWD_TPW)
#endif
#ifdef NR_FFWD_XSLOTS
shared NR_E4M3 nr_ffwd_xchg[NR_FFWD_WGW * NR_FFWD_XSLOTS * 256];
#define NR_FFWD_XBASE (NR_WAVE_OF(gl_LocalInvocationID.x) * uint(NR_FFWD_XSLOTS) * 256u)
#define NR_FFWD_XSYNC { subgroupMemoryBarrierShared(); subgroupBarrier(); }
#endif
#if NR_FFWD_FM == 2
#if !(NR_FFWD_KOFF && NR_FFWD_PACK && NR_FFWD_PAIR) || NR_FFWD_F32
#error "NR_FFWD_FM=2: the packed, paired, k-offset path only"
#endif
#define S1_K2(i)                                                                                   \
    {                                                                                              \
        NR_FRAG_B x[2];                                                                            \
        for (int m = 0; m < 2; ++m)                                                                \
            NR_LOAD_B(x[m], act_e4m3, xk + uint(m) * xm + uint(i) * 256u, 16u);                    \
        for (int n = 0; n < 2; ++n) {                                                              \
            const uint ix = (aw[n] + kw) + uint(i) * 512u;                                         \
            NR_FRAG_A w0, w1;                                                                      \
            NR_LOAD_A(w0, wgt_e4m3, ix, 16u);                                                      \
            NR_LOAD_A(w1, wgt_e4m3, ix + 256u, 16u);                                               \
            for (int m = 0; m < 2; ++m) { NR_MMA(acc1[2*n][m],w0,x[m]); NR_MMA(acc1[2*n+1][m],w1,x[m]); } \
        }                                                                                          \
    }
void main() {
    NR_PROF_BEGIN()
    nr_chain_wait()
    NR_TC_PROLOGUE
    nr_tchain_wait(NR_FFWD_T0(32u), NR_FFWD_NT(32u))
    NR_FFWD_MAP(32u)
    const bool second = tok + 16u < pc.M;   // wave-uniform
    uint xbase = pc.x_off + (tok / 16u) * (pc.C / 16u) * 256u;
    uint agrp = pc.a_off + group * 64u * 512u, q0grp = pc.q0_off + group * 256u * 64u,
         q2grp = pc.q2_off + group * 64u * 256u;
    NR_FRAG_ACC acc1[4][2], acc3[4][2];
    for (int n = 0; n < 4; ++n) for (int m = 0; m < 2; ++m) {
        acc1[n][m] = NR_ACC_ZERO;
        acc3[n][m] = NR_ACC_ZERO;
    }
    const uint xm = (pc.C / 16u) * 256u;     // one 16-token tile
    uint aw[2];
    for (int n = 0; n < 2; ++n)
        aw[n] = agrp + uint(n) * (pc.C / 16u) * 512u;
    for (uint k0 = 0u; k0 < pc.C; k0 += 128u) {
        const uint xk = xbase + k0 * 16u, kw = (k0 / 16u) * 512u;
        NR_FOR_K(8, S1_K2)
    }
    const uint xo = NR_FFWD_XBASE;
    for (int n = 0; n < 4; ++n) for (int m = 0; m < 2; ++m) {
        NR_FRAG_E4M3 qf;
        for(int c=0;c<8;c+=2) {
            fe4m3vec2 q=nr_ffwd_quant(f16vec2(acc1[n][m][c],acc1[n][m][c+1]));
            qf[c]=q.x;qf[c+1]=q.y;
        }
        NR_STORE_ACC_COL(qf, nr_ffwd_xchg, xo + uint(n * 2 + m) * 256u, 16u);
    }
    NR_FFWD_XSYNC
    NR_FRAG_B r[4][2];
    for (int n = 0; n < 4; ++n) for (int m = 0; m < 2; ++m)
        NR_LOAD_B(r[n][m], nr_ffwd_xchg, xo + uint(n * 2 + m) * 256u, 16u);
    NR_FFWD_XSYNC
    for (uint chunk = 0u; chunk < 4u; ++chunk) {
        uint jbase = chunk * 64u;
        NR_FRAG_ACC acc2[4][2];
        for (int n = 0; n < 4; ++n) for (int m = 0; m < 2; ++m) acc2[n][m] = NR_ACC_ZERO;
        for (uint k = 0u; k < 4u; ++k)
            for(uint n=0u;n<4u;n+=2u) {
                NR_FRAG_A w0,w1;
                NR_FFWD_LOAD2(w0,w1,q0grp,jbase+n*16u,k*16u,64u)
                for (int m = 0; m < 2; ++m) { NR_MMA(acc2[n][m],w0,r[k][m]);NR_MMA(acc2[n+1u][m],w1,r[k][m]); }
            }
        for (int n = 0; n < 4; ++n) for (int m = 0; m < 2; ++m) {
            NR_FRAG_E4M3 qf;
            for(int c=0;c<8;c+=2) {
                fe4m3vec2 q=nr_ffwd_quant(nr_swin_act2(f16vec2(acc2[n][m][c],acc2[n][m][c+1])));
                qf[c]=q.x;qf[c+1]=q.y;
            }
            NR_STORE_ACC_COL(qf, nr_ffwd_xchg, xo + uint(n * 2 + m) * 256u, 16u);
        }
        NR_FFWD_XSYNC
        NR_FRAG_B h[4][2];
        for (int n = 0; n < 4; ++n) for (int m = 0; m < 2; ++m)
            NR_LOAD_B(h[n][m], nr_ffwd_xchg, xo + uint(n * 2 + m) * 256u, 16u);
        NR_FFWD_XSYNC
        for (uint k = 0u; k < 4u; ++k)
            for(uint n=0u;n<4u;n+=2u) {
                NR_FRAG_A w0,w1;
                NR_FFWD_LOAD2(w0,w1,q2grp,n*16u,jbase+k*16u,256u)
                for (int m = 0; m < 2; ++m) { NR_MMA(acc3[n][m],w0,h[k][m]);NR_MMA(acc3[n+1u][m],w1,h[k][m]); }
            }
    }
    for (int m = 0; m < 2; ++m) {
        if (m == 1 && !second) break;
        for (uint n = 0u; n < 4u; ++n) {
            NR_FRAG_E4M3 outv;
            for(int c=0;c<8;c+=2) {
                fe4m3vec2 q=nr_ffwd_quant(f16vec2(acc3[n][m][c],acc3[n][m][c+1]));
                outv[c]=q.x;outv[c+1]=q.y;
            }
            NR_STORE_ACC_COL(outv, act_e4m3,
                             pc.o_off + (tok / 16u + uint(m)) * (pc.C / 16u) * 256u + (group * 4u + n) * 256u,
                             16u);
        }
    }
    NR_OCC_USE(pc.C == 0u, act_f32[0] = 0.0)
    nr_chain_signal()
    nr_tchain_signal_wave(tok / 16u, second ? 2u : 1u)
    NR_PROF_END(pc.o_off)
}
#elif NR_FFWD_FM == 4
// NR_FFWD_FM=4: one subgroup, one group, FOUR 16-token tiles - every weight
// fragment feeds four MMAs. The hidden runs in 32-wide chunks so acc3[4][NR_FFWD_TPW] and
// acc2[2][NR_FFWD_TPW] fit: stage 2 sums R in ascending k per hidden fragment, stage 3 sums
// the hidden in ascending 16-steps, stage 1 unchanged - the FM=2 order exactly.
#if !(NR_FFWD_KOFF && NR_FFWD_PACK && NR_FFWD_PAIR) || NR_FFWD_F32
#error "NR_FFWD_FM=4: the packed, paired, k-offset path only"
#endif
#define S1_K4(i)                                                                                   \
    {                                                                                              \
        NR_FRAG_B x[NR_FFWD_TPW];                                                                  \
        for (int m = 0; m < NR_FFWD_TPW; ++m)                                                      \
            NR_LOAD_B(x[m], act_e4m3, xk + uint(m) * xm + uint(i) * 256u, 16u);                    \
        for (int n = 0; n < 2; ++n) {                                                              \
            const uint ix = (aw[n] + kw) + uint(i) * 512u;                                         \
            NR_FRAG_A w0, w1;                                                                      \
            NR_LOAD_A(w0, wgt_e4m3, ix, 16u);                                                      \
            NR_LOAD_A(w1, wgt_e4m3, ix + 256u, 16u);                                               \
            for (int m = 0; m < NR_FFWD_TPW; ++m) { NR_MMA(acc1[2*n][m],w0,x[m]); NR_MMA(acc1[2*n+1][m],w1,x[m]); } \
        }                                                                                          \
    }
void main() {
    NR_PROF_BEGIN()
    nr_chain_wait()
    NR_TC_PROLOGUE
    nr_tchain_wait(NR_FFWD_T0(16u * NR_FFWD_TPW), NR_FFWD_NT(16u * NR_FFWD_TPW))
    NR_FFWD_MAP(16u * NR_FFWD_TPW)
    const uint ntiles = min(uint(NR_FFWD_TPW), (pc.M - tok) / 16u);   // wave-uniform, >= 1
    uint xbase = pc.x_off + (tok / 16u) * (pc.C / 16u) * 256u;
    uint agrp = pc.a_off + group * 64u * 512u, q0grp = pc.q0_off + group * 256u * 64u,
         q2grp = pc.q2_off + group * 64u * 256u;
    NR_FRAG_ACC acc1[4][NR_FFWD_TPW];
    for (int n = 0; n < 4; ++n) for (int m = 0; m < NR_FFWD_TPW; ++m) acc1[n][m] = NR_ACC_ZERO;
    const uint xm = (pc.C / 16u) * 256u;
    uint aw[2];
    for (int n = 0; n < 2; ++n)
        aw[n] = agrp + uint(n) * (pc.C / 16u) * 512u;
    for (uint k0 = 0u; k0 < pc.C; k0 += 128u) {
        const uint xk = xbase + k0 * 16u, kw = (k0 / 16u) * 512u;
        NR_FOR_K(8, S1_K4)
    }
    const uint xo = NR_FFWD_XBASE;
    for (int n = 0; n < 4; ++n) for (int m = 0; m < NR_FFWD_TPW; ++m) {
        NR_FRAG_E4M3 qf;
        for(int c=0;c<8;c+=2) {
            fe4m3vec2 q=nr_ffwd_quant(f16vec2(acc1[n][m][c],acc1[n][m][c+1]));
            qf[c]=q.x;qf[c+1]=q.y;
        }
        NR_STORE_ACC_COL(qf, nr_ffwd_xchg, xo + uint(n * NR_FFWD_TPW + m) * 256u, 16u);
    }
    NR_FFWD_XSYNC
    NR_FRAG_B r[4][NR_FFWD_TPW];
    for (int n = 0; n < 4; ++n) for (int m = 0; m < NR_FFWD_TPW; ++m)
        NR_LOAD_B(r[n][m], nr_ffwd_xchg, xo + uint(n * NR_FFWD_TPW + m) * 256u, 16u);
    NR_FFWD_XSYNC
    NR_FRAG_ACC acc3[4][NR_FFWD_TPW];
    for (int n = 0; n < 4; ++n) for (int m = 0; m < NR_FFWD_TPW; ++m) acc3[n][m] = NR_ACC_ZERO;
    for (uint chunk = 0u; chunk < 8u; ++chunk) {
        uint jbase = chunk * 32u;
        NR_FRAG_ACC acc2[2][NR_FFWD_TPW];
        for (int n = 0; n < 2; ++n) for (int m = 0; m < NR_FFWD_TPW; ++m) acc2[n][m] = NR_ACC_ZERO;
        for (uint k = 0u; k < 4u; ++k) {
            NR_FRAG_A w0,w1;
            NR_FFWD_LOAD2(w0,w1,q0grp,jbase,k*16u,64u)
            for (int m = 0; m < NR_FFWD_TPW; ++m) { NR_MMA(acc2[0][m],w0,r[k][m]);NR_MMA(acc2[1][m],w1,r[k][m]); }
        }
        for (int n = 0; n < 2; ++n) for (int m = 0; m < NR_FFWD_TPW; ++m) {
            NR_FRAG_E4M3 qf;
            for(int c=0;c<8;c+=2) {
                fe4m3vec2 q=nr_ffwd_quant(nr_swin_act2(f16vec2(acc2[n][m][c],acc2[n][m][c+1])));
                qf[c]=q.x;qf[c+1]=q.y;
            }
            NR_STORE_ACC_COL(qf, nr_ffwd_xchg, xo + uint(n * NR_FFWD_TPW + m) * 256u, 16u);
        }
        NR_FFWD_XSYNC
        NR_FRAG_B h[2][NR_FFWD_TPW];
        for (int n = 0; n < 2; ++n) for (int m = 0; m < NR_FFWD_TPW; ++m)
            NR_LOAD_B(h[n][m], nr_ffwd_xchg, xo + uint(n * NR_FFWD_TPW + m) * 256u, 16u);
        NR_FFWD_XSYNC
        for (uint k = 0u; k < 2u; ++k)
            for(uint n=0u;n<4u;n+=2u) {
                NR_FRAG_A w0,w1;
                NR_FFWD_LOAD2(w0,w1,q2grp,n*16u,jbase+k*16u,256u)
                for (int m = 0; m < NR_FFWD_TPW; ++m) { NR_MMA(acc3[n][m],w0,h[k][m]);NR_MMA(acc3[n+1u][m],w1,h[k][m]); }
            }
    }
    for (int m = 0; m < NR_FFWD_TPW; ++m) {
        if (uint(m) >= ntiles) break;
        for (uint n = 0u; n < 4u; ++n) {
            NR_FRAG_E4M3 outv;
            for(int c=0;c<8;c+=2) {
                fe4m3vec2 q=nr_ffwd_quant(f16vec2(acc3[n][m][c],acc3[n][m][c+1]));
                outv[c]=q.x;outv[c+1]=q.y;
            }
            NR_STORE_ACC_COL(outv, act_e4m3,
                             pc.o_off + (tok / 16u + uint(m)) * (pc.C / 16u) * 256u + (group * 4u + n) * 256u,
                             16u);
        }
    }
    NR_OCC_USE(pc.C == 0u, act_f32[0] = 0.0)
    nr_chain_signal()
    nr_tchain_signal_wave(tok / 16u, ntiles)
    NR_PROF_END(pc.o_off)
}
#elif NR_FFWD_FM == 3
// NR_FFWD_FM=3: wave pairs. The two waves of a pair own the same two token
// tiles and one half of every stage's rows each, so each weight fragment feeds
// two MMAs (two tiles) and a wave loads half the weights of the FM=1 form, at
// the same wave count (a workgroup still covers NR_FFWD_WGW tiles). The pair
// swaps the quantised stage-1 rows once and each Q0 chunk's hidden rows through
// LDS (a workgroup barrier each). Every output keeps its k order; the exchanged
// values are the quantised e4m3 values, stored as column-major tiles and loaded
// as B operands by both waves of the pair, own half included.
#if !(NR_FFWD_KOFF && NR_FFWD_PACK && NR_FFWD_PAIR) || NR_FFWD_F32 || !NR_FFWD_GMAJOR || (NR_FFWD_WGW % 2)
#error "NR_FFWD_FM=3: packed, paired, k-offset, group-major, even NR_FFWD_WGW"
#endif
shared NR_E4M3 lds_fr[NR_FFWD_WGW * 4 * 256];        // [wave][frag f][tile t] 256-element column-major tile
shared NR_E4M3 lds_fh[2 * NR_FFWD_WGW * 4 * 256];    // [buf][wave][f][t]
#define NR_FP_PUT(arr, base, frag) { NR_STORE_ACC_COL(frag, arr, base, 16u); }
#define NR_FP_GET(arr, base, frag) { NR_LOAD_B(frag, arr, base, 16u); }
void main() {
    NR_PROF_BEGIN()
    nr_chain_wait()
    NR_TC_PROLOGUE
    nr_tchain_wait(NR_FFWD_T0(16u), NR_FFWD_NT(16u))
    const uint lane = gl_LocalInvocationID.x % 32u;
    const uint wv = NR_WAVE_OF(gl_LocalInvocationID.x);
    const uint group = gl_WorkGroupID.x % 8u, hh = wv & 1u, pr = wv >> 1u;
    const uint tok = ((gl_WorkGroupID.x / 8u) * NR_FFWD_WGW + 2u * pr) * 16u;   // the pair's first tile
    const bool v0 = tok < pc.M, v1 = tok + 16u < pc.M;                           // no early return: barriers
    const uint tk0 = v0 ? tok : 0u, tk1 = v1 ? tok + 16u : tk0;                  // reads stay inside the tensor
    const uint agrp = pc.a_off + group * 64u * 512u, q0grp = pc.q0_off + group * 256u * 64u,
               q2grp = pc.q2_off + group * 64u * 256u;
    const uint xa = pc.x_off + (tk0 / 16u) * (pc.C / 16u) * 256u,
               xb = pc.x_off + (tk1 / 16u) * (pc.C / 16u) * 256u;
    const uint aw = agrp + hh * (pc.C / 16u) * 512u;                           // row pair hh: rows 32hh..32hh+31
    NR_FRAG_ACC acc1[2][2], acc3[2][2];
    for (int f = 0; f < 2; ++f) for (int t = 0; t < 2; ++t) { acc1[f][t] = NR_ACC_ZERO; acc3[f][t] = NR_ACC_ZERO; }
    for (uint k0 = 0u; k0 < pc.C; k0 += 128u) {
        // eight k steps a round, every load issued before the MMAs (as S1_K's unrolled form)
        NR_FRAG_B x[8][2];
        NR_FRAG_A w0[8], w1[8];
        for (int i = 0; i < 8; ++i) {
            NR_LOAD_B(x[i][0], act_e4m3, xa + (k0 + uint(i) * 16u) * 16u, 16u);
            NR_LOAD_B(x[i][1], act_e4m3, xb + (k0 + uint(i) * 16u) * 16u, 16u);
            const uint ix = aw + (k0 / 16u + uint(i)) * 512u;
            NR_LOAD_A(w0[i], wgt_e4m3, ix, 16u);
            NR_LOAD_A(w1[i], wgt_e4m3, ix + 256u, 16u);
        }
        for (int i = 0; i < 8; ++i)
            for (int t = 0; t < 2; ++t) { NR_MMA(acc1[0][t], w0[i], x[i][t]); NR_MMA(acc1[1][t], w1[i], x[i][t]); }
    }
    // stage-1 rows of this half, quantised, then both halves back from LDS: row block g
    // (g / 2 is its half) comes from this wave when g / 2 == hh and from the partner otherwise
    for (int f = 0; f < 2; ++f) for (int t = 0; t < 2; ++t) {
        NR_FRAG_E4M3 q;
        for(int c=0;c<8;c+=2) { fe4m3vec2 qq=nr_ffwd_quant(f16vec2(acc1[f][t][c],acc1[f][t][c+1])); q[c]=qq.x; q[c+1]=qq.y; }
        NR_FP_PUT(lds_fr, ((wv * 4u) + uint(f) * 2u + uint(t)) * 256u, q)
    }
    barrier();
    NR_FRAG_B r[4][2];
    for (int g = 0; g < 4; ++g) for (int t = 0; t < 2; ++t) {
        NR_FP_GET(lds_fr, (((wv ^ (uint(g >> 1) ^ hh)) * 4u) + uint(g & 1) * 2u + uint(t)) * 256u, r[g][t]);
    }
    for (uint chunk = 0u; chunk < 4u; ++chunk) {
        const uint jbase = chunk * 64u;
        NR_FRAG_ACC acc2[2][2];
        for (int f = 0; f < 2; ++f) for (int t = 0; t < 2; ++t) acc2[f][t] = NR_ACC_ZERO;
        {
            NR_FRAG_A qa[4], qb[4];
            for (uint k = 0u; k < 4u; ++k) { NR_FFWD_LOAD2(qa[k],qb[k],q0grp,jbase+hh*32u,k*16u,64u) }
            for (uint k = 0u; k < 4u; ++k)
                for (int t = 0; t < 2; ++t) { NR_MMA(acc2[0][t],qa[k],r[k][t]); NR_MMA(acc2[1][t],qb[k],r[k][t]); }
        }
        const uint hb = (chunk & 1u) * uint(NR_FFWD_WGW * 4 * 256);
        for (int f = 0; f < 2; ++f) for (int t = 0; t < 2; ++t) {
            NR_FRAG_E4M3 q;
            for(int c=0;c<8;c+=2) { fe4m3vec2 qq=nr_ffwd_quant(nr_swin_act2(f16vec2(acc2[f][t][c],acc2[f][t][c+1]))); q[c]=qq.x; q[c+1]=qq.y; }
            NR_FP_PUT(lds_fh, hb + ((wv * 4u) + uint(f) * 2u + uint(t)) * 256u, q)
        }
        barrier();
        NR_FRAG_B hq[4][2];
        for (int g = 0; g < 4; ++g) for (int t = 0; t < 2; ++t) {
            NR_FP_GET(lds_fh, hb + (((wv ^ (uint(g >> 1) ^ hh)) * 4u) + uint(g & 1) * 2u + uint(t)) * 256u, hq[g][t]);
        }
        {
            NR_FRAG_A qa[4], qb[4];
            for (uint k = 0u; k < 4u; ++k) { NR_FFWD_LOAD2(qa[k],qb[k],q2grp,hh*32u,jbase+k*16u,256u) }
            for (uint k = 0u; k < 4u; ++k)
                for (int t = 0; t < 2; ++t) { NR_MMA(acc3[0][t],qa[k],hq[k][t]); NR_MMA(acc3[1][t],qb[k],hq[k][t]); }
        }
    }
    for (int t = 0; t < 2; ++t) {
        if ((t == 0 && !v0) || (t == 1 && !v1)) continue;
        for (int f = 0; f < 2; ++f) {
            NR_FRAG_E4M3 outv;
            for(int c=0;c<8;c+=2) { fe4m3vec2 q=nr_ffwd_quant(f16vec2(acc3[f][t][c],acc3[f][t][c+1])); outv[c]=q.x; outv[c+1]=q.y; }
            NR_STORE_ACC_COL(outv, act_e4m3,
                             pc.o_off + (tok / 16u + uint(t)) * (pc.C / 16u) * 256u + (group * 4u + 2u * hh + uint(f)) * 256u,
                             16u);
        }
    }
    NR_OCC_USE(pc.C == 0u, act_f32[0] = 0.0)
    nr_chain_signal()
    // both halves' stores, then one signal a tile (the consumers' need is unchanged)
    memoryBarrier(gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease);
    barrier();
    if (hh == 0u && v0) nr_tchain_signal_wave(tok / 16u, v1 ? 2u : 1u)
    NR_PROF_END(pc.o_off)
}
#else
void main() {
    NR_PROF_BEGIN()
    nr_chain_wait()
    NR_TC_PROLOGUE
    nr_tchain_wait(NR_FFWD_T0(16u), NR_FFWD_NT(16u))
    NR_FFWD_MAP(16u)
    uint xbase = pc.x_off + (tok / 16u) * (pc.C / 16u) * 256u;
    uint agrp = pc.a_off + group * 64u * 512u, q0grp = pc.q0_off + group * 256u * 64u,
         q2grp = pc.q2_off + group * 64u * 256u;
    // A_g projects 512 channels to 64; the reduction order is unchanged.
    NR_FRAG_ACC acc1[4], acc3[4];
    for (int n = 0; n < 4; ++n) {
        acc1[n] = NR_ACC_ZERO;
        acc3[n] = NR_ACC_ZERO;
    }
#if NR_FFWD_KOFF && NR_FFWD_PACK
    uint aw[2];
    for (int n = 0; n < 2; ++n)
        aw[n] = agrp + uint(n) * (pc.C / 16u) * 512u;
#endif
    for (uint k0 = 0u; k0 < pc.C; k0 += 128u) {
#if NR_FFWD_KOFF && NR_FFWD_PACK
        const uint xk = xbase + k0 * 16u, kw = (k0 / 16u) * 512u;
#endif
        NR_FOR_K(8, S1_K)
    }
    // The old half-staged projection was clamped/quantized before Q0.
    const uint xo = NR_FFWD_XBASE;
    for (int n = 0; n < 4; ++n) {
        NR_FRAG_E4M3 qf;
#if NR_FFWD_F32
        for(int c=0;c<8;c+=2) {
            fe4m3vec2 q=nr_quant_pair32(vec2(acc1[n][c],acc1[n][c+1]));
            qf[c]=q.x;qf[c+1]=q.y;
        }
#elif NR_FFWD_PAIR
        for(int c=0;c<8;c+=2) {
            fe4m3vec2 q=nr_ffwd_quant(f16vec2(acc1[n][c],acc1[n][c+1]));
            qf[c]=q.x;qf[c+1]=q.y;
        }
#else
        for (int c = 0; c < 8; ++c)
            qf[c] = nr_quant_e4m3(NR_F16(acc1[n][c]));
#endif
        NR_STORE_ACC_COL(qf, nr_ffwd_xchg, xo + uint(n) * 256u, 16u);
    }
    NR_FFWD_XSYNC
    NR_FRAG_B r[4];
    for (int n = 0; n < 4; ++n)
        NR_LOAD_B(r[n], nr_ffwd_xchg, xo + uint(n) * 256u, 16u);
    NR_FFWD_XSYNC
    // Q0 expands each 64-channel group to 256. Process four 64-row chunks
    // and immediately accumulate Q2, retaining its original K order.
    for (uint chunk = 0u; chunk < 4u; ++chunk) {
        uint jbase = chunk * 64u;
        NR_FRAG_ACC acc2[4];
        for (int n = 0; n < 4; ++n)
            acc2[n] = NR_ACC_ZERO;
        for (uint k = 0u; k < 4u; ++k)
#if NR_FFWD_PACK
            for(uint n=0u;n<4u;n+=2u) {
                NR_FRAG_A w0,w1;
                NR_FFWD_LOAD2(w0,w1,q0grp,jbase+NR_DFN(n)*16u,NR_DFK(k,n)*16u,64u)
                NR_MMA(acc2[n],w0,r[k]);NR_MMA(acc2[n+1u],w1,r[k]);
            }
#else
            for (uint n = 0u; n < 4u; ++n) {
                NR_FRAG_A w;
                NR_LOAD_A(w, wgt_e4m3, TILE(q0grp, jbase + n * 16u, k * 16u, 64u), 16u);
                NR_MMA(acc2[n], w, r[k]);
            }
#endif
        for (int n = 0; n < 4; ++n) {
            NR_FRAG_E4M3 qf;
#if NR_FFWD_F32
            for(int c=0;c<8;c+=2) {
                fe4m3vec2 q=nr_quant_pair32(vec2(nr_ffwd_act32(acc2[n][c]),nr_ffwd_act32(acc2[n][c+1])));
                qf[c]=q.x;qf[c+1]=q.y;
            }
#elif NR_FFWD_PAIR
            for(int c=0;c<8;c+=2) {
                fe4m3vec2 q=nr_ffwd_quant(nr_swin_act2(f16vec2(acc2[n][c],acc2[n][c+1])));
                qf[c]=q.x;qf[c+1]=q.y;
            }
#else
            for (int c = 0; c < 8; ++c)
                qf[c] = nr_quant_e4m3(NR_F16(nr_swin_act(acc2[n][c])));
#endif
            NR_STORE_ACC_COL(qf, nr_ffwd_xchg, xo + uint(n) * 256u, 16u);
        }
        NR_FFWD_XSYNC
        NR_FRAG_B h[4];
        for (int n = 0; n < 4; ++n)
            NR_LOAD_B(h[n], nr_ffwd_xchg, xo + uint(n) * 256u, 16u);
        NR_FFWD_XSYNC
        for (uint k = 0u; k < 4u; ++k)
#if NR_FFWD_PACK
            for(uint n=0u;n<4u;n+=2u) {
                NR_FRAG_A w0,w1;
                NR_FFWD_LOAD2(w0,w1,q2grp,NR_DFN(n)*16u,jbase+NR_DFK(k,n)*16u,256u)
                NR_MMA(acc3[n],w0,h[k]);NR_MMA(acc3[n+1u],w1,h[k]);
            }
#else
            for (uint n = 0u; n < 4u; ++n) {
                NR_FRAG_A w;
                NR_LOAD_A(w, wgt_e4m3, TILE(q2grp, n * 16u, jbase + k * 16u, 256u), 16u);
                NR_MMA(acc3[n], w, h[k]);
            }
#endif
    }
    // Column-major [feature][token] stores are the canonical tile-blocked
    // [token][feature] arena used by the next graph dispatch.
    for (uint n = 0u; n < 4u; ++n) {
        NR_FRAG_E4M3 outv;
#if NR_FFWD_F32
        for(int c=0;c<8;c+=2) {
            fe4m3vec2 q=nr_quant_pair32(vec2(acc3[n][c],acc3[n][c+1]));
            outv[c]=q.x;outv[c+1]=q.y;
        }
#elif NR_FFWD_PAIR
        for(int c=0;c<8;c+=2) {
            fe4m3vec2 q=nr_ffwd_quant(f16vec2(acc3[n][c],acc3[n][c+1]));
            outv[c]=q.x;outv[c+1]=q.y;
        }
#else
        for (int c = 0; c < 8; ++c)
            outv[c] = nr_quant_e4m3(NR_F16(acc3[n][c]));
#endif
        NR_STORE_ACC_COL(outv, act_e4m3,
                         pc.o_off + (tok / 16u) * (pc.C / 16u) * 256u + (group * 4u + n) * 256u,
                         16u);
    }
    NR_OCC_USE(pc.C == 0u, act_f32[0] = 0.0)
    nr_chain_signal()
    nr_tchain_signal_wave(tok / 16u, 1u)
    NR_PROF_END(pc.o_off)
}
