#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// The pre-block's noise features (image_input.glsl, NR_NOISE_FIELD), computed
// once at build: for every pixel of the padded working grid, the three f16
// values the pre-block would put in input features 0..2 - the same code, so the
// same bytes - packed f16 x4 (the fourth half zero), row-major.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, std430) buffer NoiseOut { uint nr_noise_u32[]; };
layout(push_constant) uniform Push {
    uint off;           // u32 index of pixel (0, 0)
    uint width, height; // the padded working grid (pre-block groups x 8)
    uint seed;
    float noise;        // the noise gain
} pc;
#include "image_noise.glsl"
void main() {
    const uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) return;
    nr_gauss3(x, y, pc.seed);
    const float16_t a = float16_t(pc.noise * nr_g0), b = float16_t(pc.noise * nr_g1),
                    c = float16_t(pc.noise * nr_g2);
    const uint i = pc.off + (y * pc.width + x) * 2u;
    nr_noise_u32[i] = packFloat2x16(f16vec2(a, b));
    nr_noise_u32[i + 1u] = packFloat2x16(f16vec2(c, float16_t(0.0)));
}
