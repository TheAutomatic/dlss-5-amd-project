# 钩子是 sh 脚本，必须保持 LF。
# 本仓库 core.autocrlf=true，不加这条的话 checkout 会把它们转成 CRLF，
# 于是 case 模式、heredoc、变量里都会混进多余的 \r —— 典型症状是
# 「\r: command not found」和莫名其妙匹配不上的分支。
.githooks/* text eol=lf

# Unified patches are applied to LF git-archive files on Windows too.
tools/lmxxf-sync/patches/*.patch text eol=lf
# Unified patch blank context lines carry a required space; git apply checks source whitespace.
tools/mochizuki-sync/patches/*.patch text eol=lf whitespace=-blank-at-eol
# Dormant research patches must remain directly applicable after a Windows checkout.
docs/research/nr-capture-proof/*.patch text eol=lf whitespace=-blank-at-eol

# Frozen upstream fixtures: their raw SHA256 must survive a Windows checkout.
tests/sync/fixtures/lmxxf/*.upstream.* text eol=lf
tests/sync/fixtures/lmxxf/*.raw text eol=lf

# Vendor sources that local_patches apply to must match git-archive LF.
third_party/lmxxf/** text=auto eol=lf
# GPU modules are opaque binaries even when they happen to contain CRLF bytes.
third_party/lmxxf/**/*.hsaco -text

# Vendored official NR ASI payload: binaries and resource text must stay byte-exact.
third_party/mochizuki-asi/payload/** -text
