--- a/linux/shaders/passes/runtime_alpha.comp
+++ b/linux/shaders/passes/runtime_alpha.comp
@@ -1,4 +1,70 @@
 #version 460
+#if defined(NR_PACK_F16) || defined(NR_UNPACK_F16) || defined(NR_PACK_R11)
+// Equal-extent nearest conversion; no tone mapping, clamp or UNORM quantization.
+layout(local_size_x=8, local_size_y=8) in;
+#ifdef NR_UNPACK_F16
+layout(set=0,binding=0) uniform sampler2D source;
+layout(set=0,binding=1,rgba32f) uniform writeonly image2D result;
+#else
+layout(set=0,binding=0,rgba32f) uniform readonly image2D source;
+#ifdef NR_PACK_R11
+// B10G11R11 write-back (runtime_pack_r11.spv): the storage format conversion is the blit's own.
+layout(set=0,binding=1,r11f_g11f_b10f) uniform writeonly image2D result;
+#else
+layout(set=0,binding=1,rgba16f) uniform writeonly image2D result;
+#endif
+#endif
+layout(push_constant) uniform Push { uint width, height; } pc;
+void main() {
+    ivec2 xy=ivec2(gl_GlobalInvocationID.xy);
+    if (xy.x>=pc.width || xy.y>=pc.height) return;
+#ifdef NR_UNPACK_F16
+    imageStore(result,xy,texelFetch(source,xy,0));
+#else
+#ifdef NR_PACK_R11
+    // Match the format-converting blit / planA unconvert: NaN->0, clamp to the largest finite (65024).
+    vec4 texel=imageLoad(source,xy);
+    texel=mix(texel,vec4(0.0),isnan(texel));
+    texel=clamp(texel,vec4(0.0),vec4(65024.0));
+    imageStore(result,xy,texel);
+#else
+    imageStore(result,xy,imageLoad(source,xy));
+#endif
+#endif
+}
+#elif defined(NR_PACK_U8) || defined(NR_PACK_U8_BGRA) || defined(NR_PACK_U10) || defined(NR_PACK_U10_BGRA)
+// Inline compute-family write-back of a packed 32-bit frame. The format-converting blit is
+// graphics-only, so the bits go to an R32_UINT image of the same 32-bit copy class; a copy places them.
+//   NR_PACK_U8       R8G8B8A8 (UNORM or SRGB twin): the answer already holds k/255 (alpha pass,
+//                    encode_u8), so this rounding equals the blit's float -> UNORM conversion.
+//   NR_PACK_U8_BGRA  B8G8R8A8: the same, blue in the low byte.
+//   NR_PACK_U10      A2B10G10R10: round to nearest, red in the low 10 bits, 2-bit alpha on top.
+//   NR_PACK_U10_BGRA A2R10G10B10: the same, blue in the low 10 bits.
+layout(local_size_x=8, local_size_y=8) in;
+layout(set=0,binding=0,rgba32f) uniform readonly image2D answer;
+layout(set=0,binding=1,r32ui) uniform writeonly uimage2D packed;
+layout(push_constant) uniform Push { uint width, height; } pc;
+void main() {
+    ivec2 xy=ivec2(gl_GlobalInvocationID.xy);
+    if (xy.x>=pc.width || xy.y>=pc.height) return;
+    vec4 v=imageLoad(answer,xy);
+    v=mix(v,vec4(0),isnan(v));
+#if defined(NR_PACK_U8_BGRA) || defined(NR_PACK_U10_BGRA)
+    v=v.bgra;
+#endif
+#if defined(NR_PACK_U10) || defined(NR_PACK_U10_BGRA)
+    precise vec4 scaled=clamp(v,vec4(0),vec4(1))*vec4(1023.0,1023.0,1023.0,3.0);
+    precise vec4 shifted=scaled+0.5;
+    uvec4 q=uvec4(floor(shifted));
+    imageStore(packed,xy,uvec4(q.r | (q.g<<10) | (q.b<<20) | (q.a<<30),0u,0u,0u));
+#else
+    precise vec4 scaled=clamp(v,vec4(0),vec4(1))*255.0;
+    precise vec4 shifted=scaled+0.5;
+    uvec4 q=uvec4(floor(shifted));
+    imageStore(packed,xy,uvec4(q.r | (q.g<<8) | (q.b<<16) | (q.a<<24),0u,0u,0u));
+#endif
+}
+#else
 // Preserve caller alpha. Float output keeps NR RGB; 8-bit output uses the same
 // explicit rounding as the reference frame writer before the driver's format-converting blit.
 layout(local_size_x=8, local_size_y=8) in;
@@ -16,3 +82,4 @@ void main() {
     }
     imageStore(result,xy,vec4(rgb,texelFetch(original,xy,0).a));
 }
+#endif
