diff --git a/linux/shaders/passes/runtime_mv_rescale.comp b/linux/shaders/passes/runtime_mv_rescale.comp
new file mode 100644
index 0000000000000000000000000000000000000000..1d993d870ed4d28a35b1c3c0a77443d8aa483d31
--- /dev/null
+++ b/linux/shaders/passes/runtime_mv_rescale.comp
@@ -0,0 +1,21 @@
+#version 460
+// Motion vectors of another extent onto the network's subrect, on any queue family: the compute form of the
+// adapter's LINEAR blit. Each destination texel (x, y) < (width, height) samples the source at
+// ((x, y) + 0.5) * (srcWidth, srcHeight) / (width, height) texels, bilinear with clamp-to-edge, as
+// vkCmdBlitImage with VK_FILTER_LINEAR does. Values are not scaled; the caller's motion scale covers that.
+//
+//   binding 0: the uploaded vectors, sampled (LINEAR, CLAMP_TO_EDGE).
+//   binding 1: the bucket-sized image, a storage image in MV_DST_FORMAT (rg16f, rg32f, rgba16f or rgba32f).
+//
+// Both images are GENERAL; the caller pads past (width, height) afterwards.
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform sampler2D src;
+layout(set = 0, binding = 1, MV_DST_FORMAT) uniform writeonly image2D dst;
+layout(push_constant) uniform Push { uint width, height, srcWidth, srcHeight; } pc;
+
+void main() {
+    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
+    if (xy.x >= int(pc.width) || xy.y >= int(pc.height)) return;
+    const vec2 at = (vec2(xy) + 0.5) * vec2(pc.srcWidth, pc.srcHeight) / vec2(pc.width, pc.height);
+    imageStore(dst, xy, textureLod(src, at / vec2(textureSize(src, 0)), 0.0));
+}
