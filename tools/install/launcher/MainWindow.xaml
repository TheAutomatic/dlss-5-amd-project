                      <RadioButton x:Name="ReshadeApiDxRadio" Content="DX10 / DX11 / DX12" GroupName="ReShadeApi" Style="{StaticResource PillRadio}" IsChecked="True" FontFamily="Segoe UI, Microsoft YaHei UI"/>
