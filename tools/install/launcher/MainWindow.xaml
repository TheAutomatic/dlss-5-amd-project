          <TextBlock.Style>
            <Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
      <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
        <Border Width="1" Height="12" Background="{DynamicResource ThemeHairline}" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="HardwareInfo" VerticalAlignment="Center" Foreground="{DynamicResource ThemeFaint}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <!-- Anti-resale notice: always visible, low-key, out of the title bar. -->
      <Border x:Name="TopWarning" Grid.Column="2" Background="Transparent" VerticalAlignment="Center" Margin="0,0,14,0">
        <StackPanel Orientation="Horizontal">
          <Path Width="16" Height="16" Stretch="None" Stroke="{DynamicResource ThemeWarning}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,5,0" VerticalAlignment="Center"
                Data="M 8 1.75 L 13.25 3.75 V 7.75 C 13.25 10.75 11 13 8 14.25 C 5 13 2.75 10.75 2.75 7.75 V 3.75 Z M 5.75 8 L 7.25 9.5 L 10.25 6.5"/>
          <TextBlock x:Name="RefundWarning" FontSize="11.5" Foreground="{DynamicResource ThemeWarning}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
      <TextBlock Grid.Column="3" FontSize="11.5" Foreground="{DynamicResource ThemeFaint}" VerticalAlignment="Center" Margin="0,0,8,0"><Run x:Name="AuthorCaption"/><Hyperlink x:Name="AuthorLink" NavigateUri="https://github.com/TheAutomatic/dlss-5-amd-project" Cursor="Hand"><Hyperlink.Style><Style TargetType="Hyperlink"><Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/><Setter Property="TextDecorations" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/><Setter Property="TextDecorations" Value="Underline"/></Trigger></Style.Triggers></Style></Hyperlink.Style>TheAutomatic</Hyperlink></TextBlock>
      <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="DiagnosticModeIndicator" Foreground="{DynamicResource ThemeAccentText}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
        <Button x:Name="QuickLogButton" Style="{DynamicResource SubtleButton}" Height="26" MinHeight="26" Padding="6,0,8,0" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center"
                local:DialogTheme.Icon="M 4 1.75 H 9.5 L 12.5 4.75 V 14.25 H 4 Z M 9.5 1.75 V 4.75 H 12.5 M 6 8 H 10.5 M 6 10.5 H 10.5"/>
      </StackPanel>
      <TextBlock x:Name="CountText" Visibility="Collapsed"/><TextBlock x:Name="VersionText" Visibility="Collapsed"/>
    </Grid>

    <!-- ===== Settings: centred floating card over a scrim (click outside / Esc closes) ===== -->
    <Border x:Name="SettingsPage" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="20" Visibility="Collapsed" Background="{DynamicResource ThemeScrim}">
      <Border x:Name="SettingsCard" Width="780" MaxHeight="580" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8">
        <Border.Effect><DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.28"/></Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- Left brand panel: large crisp app icon displayed alongside settings -->
          <Border Grid.Column="0" Background="{DynamicResource ThemeLayer}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="0,0,1,0" CornerRadius="8,0,0,8" Padding="20,24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Image x:Name="SettingsBrandIcon" Width="144" Height="144" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" HorizontalAlignment="Center">
                <Image.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.22"/></Image.Effect>
              </Image>
              <TextBlock Text="OptiScaler(NR)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeInk}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
              <TextBlock x:Name="SettingsVersionText" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              <TextBlock x:Name="SettingsAuthorText" FontSize="11.5" Foreground="{DynamicResource ThemeFaint}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
          <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource ThemeLayer}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,0" Padding="24,12">
              <Button x:Name="SettingsCloseButton" Style="{DynamicResource GhostButton}" HorizontalAlignment="Right" MinWidth="96" Height="32"/>
            </Border>
            <TextBlock x:Name="SettingsHeading" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ThemeInk}" Margin="24,20,24,14"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,20,18">
            <StackPanel>
              <Border x:Name="SettingsOptionsPanel" Style="{StaticResource Card}" Padding="0">
              <StackPanel>
              <Border Padding="16,10">
                <DockPanel>
                  <ComboBox x:Name="LangCombo" DockPanel.Dock="Right" Width="180" Height="32"/>
                  <TextBlock x:Name="LanguageHeading" Foreground="{DynamicResource ThemeInk}" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Border Background="{DynamicResource ThemeBorder}" Height="1" Margin="16,0"/>
              <Border Padding="16,10">
                <DockPanel>
                  <ComboBox x:Name="ThemeCombo" DockPanel.Dock="Right" Width="180" Height="32"/>
                  <TextBlock x:Name="ThemeHeading" Foreground="{DynamicResource ThemeInk}" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Border Background="{DynamicResource ThemeBorder}" Height="1" Margin="16,0"/>
              <Border Padding="16,12">
                <DockPanel>
                  <Button x:Name="DiagnosticModeButton" DockPanel.Dock="Right" Style="{DynamicResource CardAction}" Height="30" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  <CheckBox x:Name="ScanOnStartup" Style="{DynamicResource ToggleSwitch}" FontSize="13" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Grid x:Name="DiagnosticPackagePanel" Visibility="Collapsed">
                <Border Background="{DynamicResource ThemeBorder}" Height="1" Margin="16,0" VerticalAlignment="Top"/>
                <StackPanel Margin="16,12">
                  <TextBlock x:Name="PackageHeading" Foreground="{DynamicResource ThemeInk}" Margin="0,0,0,8"/>
                  <DockPanel>
                    <Button x:Name="PackageBrowse" DockPanel.Dock="Right" Style="{DynamicResource CardAction}" Height="32" Width="92" Margin="8,0,0,0"/>
                    <TextBox x:Name="PackageRootBox" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                  </DockPanel>
                  <TextBlock x:Name="PackageDesc" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,8,0,0"/>
                </StackPanel>
              </Grid>
              </StackPanel>
              </Border>
              <TextBlock x:Name="CommunityHeading" Style="{StaticResource SectionHeader}" FontSize="13" Margin="2,18,0,8"/>
              <WrapPanel>
                <Button x:Name="GithubButton" Style="{DynamicResource CardAction}" Height="30" Margin="0,0,8,8" ToolTip="https://github.com/TheAutomatic/dlss-5-amd-project"
                        local:DialogTheme.Icon="M 9 2.5 H 13.5 V 7 M 13.5 2.5 L 7.5 8.5 M 11.5 9.5 V 13.5 H 2.5 V 4.5 H 6.5"/>
                <Button x:Name="MochizukiAuthorButton" Content="mochizuki0323" Style="{DynamicResource CardAction}" Height="30" Margin="0,0,8,8" ToolTip="https://gitlab.com/mochizuki0323/DLSSNR-AMD"
                        local:DialogTheme.Icon="M 9 2.5 H 13.5 V 7 M 13.5 2.5 L 7.5 8.5 M 11.5 9.5 V 13.5 H 2.5 V 4.5 H 6.5"/>
                <Button x:Name="OpenRrAsiButton" Content="OpenRR-ASI" Style="{DynamicResource CardAction}" Height="30" Margin="0,0,8,8" ToolTip="https://github.com/TheAutomatic/OpenRR-ASI"
                        local:DialogTheme.Icon="M 9 2.5 H 13.5 V 7 M 13.5 2.5 L 7.5 8.5 M 11.5 9.5 V 13.5 H 2.5 V 4.5 H 6.5"/>
                <Button x:Name="RtxRemixMcPatchButton" Style="{DynamicResource CardAction}" Height="30" Margin="0,0,8,8" ToolTip="https://github.com/TheAutomatic/rtx-remix-minecraft-amd-patch"
                        local:DialogTheme.Icon="M 9 2.5 H 13.5 V 7 M 13.5 2.5 L 7.5 8.5 M 11.5 9.5 V 13.5 H 2.5 V 4.5 H 6.5"/>
                <Button x:Name="BilibiliButton" Style="{DynamicResource CardAction}" Height="30" Margin="0,0,8,8" ToolTip="https://space.bilibili.com/291088"
                        local:DialogTheme.Icon="M 9 2.5 H 13.5 V 7 M 13.5 2.5 L 7.5 8.5 M 11.5 9.5 V 13.5 H 2.5 V 4.5 H 6.5"/>
              </WrapPanel>
            </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
