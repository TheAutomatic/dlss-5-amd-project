                          <Button x:Name="MochiHotkeysButton" Style="{DynamicResource CardAction}" Margin="0,0,8,0"/>
                          <Button x:Name="MochiShareCodeButton" Style="{DynamicResource CardAction}"/>
                        </StackPanel>
                        <CheckBox x:Name="MochiCheck" Style="{DynamicResource ToggleSwitch}" Content="mochizuki 0.0.9 M12" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" IsChecked="True" IsEnabled="True"/>
                      </DockPanel>
                      <TextBlock x:Name="MochiDescription" Grid.Row="1" Style="{StaticResource Caption}" Margin="52,6,0,0"/>
                      <TextBlock x:Name="MochiMcWarningText" Grid.Row="2" FontSize="12" Foreground="{DynamicResource ThemeMuted}" Margin="52,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                      <Border x:Name="MochiBadge" Grid.Row="3" Style="{StaticResource Badge}" Margin="52,10,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Margin="0,0,5,0" Fill="{Binding Foreground, ElementName=MochiReason}"/><TextBlock x:Name="MochiReason" FontSize="11" Foreground="{DynamicResource ThemeMuted}"/></StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                </Grid>
                <Border x:Name="MochiCollapsedBar" Style="{StaticResource InfoBar}" Visibility="Collapsed">
                  <DockPanel>
                    <Button x:Name="UnlockMochiMcBtn" DockPanel.Dock="Right" Style="{DynamicResource CardAction}" Margin="12,0,0,0" VerticalAlignment="Center" Content="仍要解锁"/>
                    <Path DockPanel.Dock="Left" Width="16" Height="16" Stretch="None" Stroke="{DynamicResource ThemeMuted}" StrokeThickness="1.2" Margin="0,0,10,0" VerticalAlignment="Center"
                          Data="M 3.75 7.25 H 12.25 V 13.75 H 3.75 Z M 5.5 7.25 V 5 A 2.5 2.5 0 0 1 10.5 5 V 7.25"/>
                    <TextBlock x:Name="MochiCollapsedText" Text="RTX Remix Minecraft 不推荐使用神经渲染（Mochizuki NR），已默认锁定" FontSize="12" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </DockPanel>
                </Border>
                <Border x:Name="OpenRrCard" Style="{StaticResource Card}" Margin="0,8,0,0">
