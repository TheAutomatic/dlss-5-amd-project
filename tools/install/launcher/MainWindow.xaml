<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:OptScalerNR.Launcher;assembly=OptScalerNR.Launcher"
        Title="OptScaler NR - 本软件免费，如付费购买请立即退款！"
        Width="1200" Height="780"
        MinWidth="1020" MinHeight="660"
        Background="{DynamicResource ThemeBackground}"
        Foreground="{DynamicResource ThemeInk}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        BorderBrush="{DynamicResource ThemeBorder}"
        BorderThickness="1"
        AllowDrop="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56"
                  ResizeBorderThickness="6"
                  CornerRadius="0"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Modern Dark ScrollBar -->
    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
      <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="true">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Background="{DynamicResource ThemeBorder}" CornerRadius="4" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeMuted}"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="true">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="MinHeight" Value="8"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ComboBox Toggle Button Template -->
    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
      <Border x:Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
          </Grid.ColumnDefinitions>
          <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ThemeMuted}" Data="M 0 0 L 4 4 L 8 0 Z"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="true">
          <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeMuted}"/>
          <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ThemeInk}"/>
        </Trigger>
        <Trigger Property="IsChecked" Value="true">
          <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Dark ComboBox Style -->
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Background" Value="{DynamicResource ThemeSubtle}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="SnapsToDevicePixels" Value="true"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="false"
                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>
              <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Slide">
                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border x:Name="DropDownBorder" Background="{DynamicResource ThemeSubtle}" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorder}" CornerRadius="6" Margin="0,4,0,4">
                    <ScrollViewer Margin="4,4" SnapsToDevicePixels="True">
                      <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dark ComboBoxItem Style -->
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="SnapsToDevicePixels" Value="true"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent" SnapsToDevicePixels="true">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHover}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LibraryFilter" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}"/>
    </Style>
    <Style x:Key="LibraryFilterItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}"/>
      <Setter Property="Margin" Value="1"/>
    </Style>

    <!-- Modern CheckBox -->
    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1.5" VerticalAlignment="Center" Margin="0,0,8,0">
                <Path x:Name="Check" Data="M 3 8 L 7 12 L 14 4" Stroke="{DynamicResource ThemeOnAccent}" StrokeThickness="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeMuted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Card Surface Style -->
    <Style x:Key="Surface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>

    <!-- Status Pill RadioButton Style -->
    <Style x:Key="PillRadio" TargetType="{x:Type RadioButton}">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Grid x:Name="Body">
              <Border x:Name="PillBorder" CornerRadius="15" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Background="{DynamicResource ThemeSubtle}"/>
              <Border CornerRadius="15" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#10FFFFFF" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.Background></Border>
              <StackPanel x:Name="Label" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,6">
                <Ellipse x:Name="Indicator" Width="6" Height="6" Fill="{DynamicResource ThemeMuted}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center" TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="{TemplateBinding FontSize}"/>
              </StackPanel>
              <Border x:Name="KeyboardRing" Margin="-3" CornerRadius="18" BorderThickness="1.5" BorderBrush="{DynamicResource ThemeMuted}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="true"><Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
              <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#202938"/>
                <Setter TargetName="PillBorder" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#252D3E" Offset="0"/><GradientStop Color="#111725" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
                <Setter TargetName="Indicator" Property="Fill" Value="{DynamicResource ThemeAccent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Label" Property="Opacity" Value="0.75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Window Caption Buttons (Modern Fluent Integrated Chrome) -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="KeyboardRing" Margin="2" BorderThickness="1.5" BorderBrush="{DynamicResource ThemeMuted}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSubtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSubtle}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="KeyboardRing" Margin="2" BorderThickness="1.5" BorderBrush="{DynamicResource ThemeMuted}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFE81123"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFF1707A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GameContextMenu" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource ThemeSubtle}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GameContextMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinWidth" Value="160"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="MenuItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource ThemeHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GameContextMenuSeparator" TargetType="Separator">
      <Setter Property="Margin" Value="6,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="{DynamicResource ThemeBorder}" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Game List Item Style with Crimson Selection Accent -->
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="12" SnapsToDevicePixels="True"/>
              <Border x:Name="Accent" Background="{DynamicResource ThemeAccent}" Width="3" Height="22" CornerRadius="1.5" HorizontalAlignment="Left" Visibility="Collapsed"/>
              <ContentPresenter Margin="9,7"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSubtle}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSubtle}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                <Setter TargetName="Bd" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.08"/></Setter.Value></Setter>
                <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Background="{DynamicResource ThemeBackground}">
    <Border DockPanel.Dock="Top" Height="60" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="8" Margin="0,0,9,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF4D4D" Offset="0"/><GradientStop Color="#C40E1E" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="N" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="OptScaler NR" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border x:Name="VersionBadge" Width="90" Height="26" VerticalAlignment="Center" Background="{DynamicResource ThemeSubtle}" CornerRadius="13" Padding="8,0" Margin="7,0,0,0"><TextBlock x:Name="VersionTag" FontSize="10" Foreground="{DynamicResource ThemeMuted}" Text="1.13.0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/></Border>
          <Border x:Name="TopWarning" Width="220" Height="26" VerticalAlignment="Center" Background="{DynamicResource ThemeWarningBg}" CornerRadius="13" Padding="9,0" Margin="8,0,0,0"><TextBlock x:Name="RefundWarning" FontSize="10" Foreground="{DynamicResource ThemeWarning}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock x:Name="PageTitle" Visibility="Collapsed"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource ThemeSubtle}" CornerRadius="16" Height="32" MinWidth="112" MaxWidth="190" HorizontalAlignment="Stretch" Margin="8,0" WindowChrome.IsHitTestVisibleInChrome="True">
          <DockPanel Margin="10,0"><TextBlock Text="⌕" FontSize="18" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource ThemeInk}" CaretBrush="{DynamicResource ThemeInk}" BorderThickness="0" VerticalContentAlignment="Center" Margin="5,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True"/></DockPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="AddMenuButton" Style="{DynamicResource GhostButton}" Background="#0D1220" Foreground="White" Padding="12,0" Margin="0,0,5,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Popup x:Name="AddMenuPopup" PlacementTarget="{Binding ElementName=AddMenuButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,5,0,0"><StackPanel>
              <Button x:Name="AddButton" Style="{DynamicResource GhostButton}" BorderThickness="0" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
              <Button x:Name="AddFolderButton" Style="{DynamicResource GhostButton}" BorderThickness="0" HorizontalContentAlignment="Left"/>
            </StackPanel></Border>
          </Popup>
          <Button x:Name="RefreshButton" Content="↻" Style="{DynamicResource GhostButton}" Width="32" Padding="0" FontSize="18" Margin="0,0,5,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Border Background="{DynamicResource ThemeSubtle}" CornerRadius="16" Padding="2" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><Button x:Name="LangZh" Style="{DynamicResource GhostButton}" Width="30" Height="28" Padding="0" WindowChrome.IsHitTestVisibleInChrome="True"/><Button x:Name="LangEn" Content="EN" Style="{DynamicResource GhostButton}" Width="30" Height="28" Padding="0" WindowChrome.IsHitTestVisibleInChrome="True"/></StackPanel></Border>
          <Button x:Name="LangToggle" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="ThemeToggle" Style="{DynamicResource GhostButton}" Width="36" Padding="0" Margin="0,0,5,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="SettingsTab" Style="{DynamicResource GhostButton}" Width="76" Padding="9,0" Margin="0,0,5,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="LibraryTab" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="MinBtn" Style="{StaticResource CaptionButton}" Content="—" WindowChrome.IsHitTestVisibleInChrome="True"/><Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="▢" WindowChrome.IsHitTestVisibleInChrome="True"/><Button x:Name="CloseBtn" Style="{StaticResource CloseCaptionButton}" Content="✕" WindowChrome.IsHitTestVisibleInChrome="True"/></StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="44" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
      <DockPanel Margin="18,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="DiagnosticModeIndicator" Foreground="#E3122B" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/><Button x:Name="QuickLogButton" Style="{DynamicResource GhostButton}" BorderThickness="0" Background="Transparent" Padding="9,0" VerticalAlignment="Center"/></StackPanel>
        <Grid Height="26" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusLed" Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource ThemeSuccess}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMuted}" FontSize="11" MaxWidth="240" TextTrimming="CharacterEllipsis"/><Border Width="1" Height="14" Background="{DynamicResource ThemeBorder}" Margin="12,0" VerticalAlignment="Center"/></StackPanel>
          <DockPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center"><Run x:Name="AuthorCaption"/><Hyperlink x:Name="AuthorLink" NavigateUri="https://github.com/TheAutomatic/dlss-5-amd-project" Cursor="Hand"><Hyperlink.Style><Style TargetType="Hyperlink"><Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/><Setter Property="TextDecorations" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/><Setter Property="TextDecorations" Value="Underline"/></Trigger></Style.Triggers></Style></Hyperlink.Style>TheAutomatic</Hyperlink></TextBlock><TextBlock x:Name="HardwareInfo" VerticalAlignment="Center" Foreground="{DynamicResource ThemeMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel>
        </Grid>
        <TextBlock x:Name="CountText" Visibility="Collapsed"/><TextBlock x:Name="VersionText" Visibility="Collapsed"/>
      </DockPanel>
    </Border>
    <Grid>
      <Grid x:Name="LibraryPage" Margin="16,16,16,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="296"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Surface}" Margin="0,0,0,0" Padding="10">
          <DockPanel Background="Transparent">
            <Grid DockPanel.Dock="Top" Margin="2,0,2,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="LocalGamesHeading" Text="游戏库" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
              <Border x:Name="CountBadgeBorder" Grid.Column="1" Background="{DynamicResource ThemeSubtle}" CornerRadius="9" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="CountBadge" FontSize="10" Foreground="{DynamicResource ThemeMuted}"/></Border>
              <ComboBox x:Name="FilterCombo" Style="{StaticResource LibraryFilter}" ItemContainerStyle="{StaticResource LibraryFilterItem}" Grid.Column="2" HorizontalAlignment="Right" MaxWidth="130" MinWidth="62" Height="26" FontSize="11" Padding="9,0,25,0"/>
            </Grid>
            <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <!-- Keep the dark surface when installation disables game selection. -->
              <ListBox.Template>
                <ControlTemplate TargetType="{x:Type ListBox}">
                  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                    <ScrollViewer x:Name="PART_ScrollViewer" Focusable="false" Padding="{TemplateBinding Padding}">
                      <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ScrollViewer>
                  </Border>
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="42"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Poster Cover / Monogram Fallback -->
                    <Border Width="42" Height="42" CornerRadius="9" Background="{DynamicResource ThemeHover}" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Border.Clip><RectangleGeometry Rect="0,0,42,42" RadiusX="9" RadiusY="9"/></Border.Clip>
                      <Grid>
                        <!-- Stylized Initial Monogram -->
                        <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" Foreground="{DynamicResource ThemeInk}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Cover Poster Image or Extracted Icon -->
                        <Image Source="{Binding DisplayImage}" Visibility="{Binding CoverVisibility}" Stretch="{Binding ImageStretch}"/>
                      </Grid>
                    </Border>

                    <!-- Name and Source Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                      <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeInk}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                      <TextBlock Text="{Binding SourceText}" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource ThemeMuted}"/>
                    </StackPanel>

                    <!-- Installation Dot / Status -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding StatusExplanation}"><Ellipse Width="4" Height="4" Fill="{Binding StatusBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/><TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{Binding StatusBrush}"/></StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <ScrollViewer x:Name="DetailsScroll" Grid.Column="2" Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border x:Name="HeroCard" Background="#101522" CornerRadius="18" Height="166" ClipToBounds="True">
              <Grid>
                <TextBlock x:Name="HeroMonogram" Text="N" FontSize="190" FontWeight="Black" Foreground="#26394C" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-50,40,-50"/>
                <Image x:Name="HeroBgImage" Stretch="UniformToFill" Opacity="0.75"/>
                <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F2101522" Offset="0"/><GradientStop Color="#B0101522" Offset="0.55"/><GradientStop Color="#50101522" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                <Border><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#C0101522" Offset="0"/><GradientStop Color="#00101522" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                <Grid Margin="20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="HeroKicker" Foreground="#CCD5E4" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeroTitle" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,5,0,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="HeroMeta" Foreground="#CCD5E4" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock x:Name="HeroPath" Foreground="#9BA8BA" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                  </StackPanel>
                  <Grid Grid.Column="1">
                    <Button x:Name="PrimaryButton" Style="{DynamicResource PrimaryButton}" Height="42" VerticalAlignment="Center" Padding="8,0" IsEnabled="False"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF5A3C" Offset="0"/><GradientStop Color="#E3122B" Offset="1"/></LinearGradientBrush></Button.Background></Button>
                    <WrapPanel VerticalAlignment="Bottom" HorizontalAlignment="Right"><Button x:Name="LaunchGameButton" Style="{DynamicResource HeroButton}" Height="27" Padding="8,0" IsEnabled="False"/><Button x:Name="ManageGameButton" Style="{DynamicResource HeroButton}" Height="27" Padding="8,0" Margin="5,0,0,0" IsEnabled="False"/><Button x:Name="OpenFolderButton" Style="{DynamicResource HeroButton}" Height="27" Padding="8,0" Margin="5,0,0,0"/><Button x:Name="UninstallButton" Style="{DynamicResource HeroButton}" Height="27" Padding="8,0" Margin="5,0,0,0" IsEnabled="False"/></WrapPanel>
                  </Grid>
                </Grid>
                <ProgressBar x:Name="Progress" Height="3" VerticalAlignment="Bottom" Foreground="{DynamicResource ThemeAccent}" Background="#30405060" BorderThickness="0"/>
                <Grid Visibility="Collapsed"><TextBlock x:Name="HeroPosterInitial"/><Image x:Name="HeroPosterImage"/></Grid>
              </Grid>
            </Border>
            <Border x:Name="BackendSection" Style="{StaticResource Surface}" Padding="15,12" Margin="0,12,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,6"><TextBlock x:Name="BackendsHeading" Foreground="{DynamicResource ThemeMuted}" FontSize="11.5" VerticalAlignment="Center"/><Button x:Name="RefreshBackendsButton" Style="{DynamicResource GhostButton}" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right"><Path Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource ThemeMuted}" StrokeThickness="1.5" Data="M 12 5 A 5 5 0 1 0 12 9 M 12 1 L 12 5 L 8 5"/></Button><ComboBox x:Name="ActiveCombo" Visibility="Collapsed"/></Grid>
                <UniformGrid Columns="3">
                  <Border Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="10,9" Margin="0,0,5,0" MinHeight="90">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <DockPanel>
                        <Button x:Name="MochiShareCodeButton" DockPanel.Dock="Right" Style="{DynamicResource GhostButton}" Height="22" FontSize="10" Padding="8,0" Margin="6,0,0,0" VerticalAlignment="Top"/>
                        <CheckBox x:Name="MochiCheck" Content="mochizuki" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Top"/>
                      </DockPanel>
                      <Grid Grid.Row="2" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="MochiBadge" Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="MochiReason" FontSize="10" Foreground="{DynamicResource ThemeMuted}"/></Border>
                        <Button x:Name="MochiActiveBtn" Grid.Column="1" Style="{DynamicResource GhostButton}" Height="23" FontSize="10" Padding="7,0" Margin="5,0,0,0"/>
                        <TextBlock x:Name="MochiActiveLabel" Grid.Column="1" Foreground="{DynamicResource ThemeAccent}" FontSize="10" VerticalAlignment="Center" Visibility="Collapsed" Margin="5,0,0,0"/>
                      </Grid>
                      <TextBlock x:Name="MochiDescription" Grid.Row="1" FontSize="10" Foreground="{DynamicResource ThemeMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </Grid>
                  </Border>
                  <Border Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="10,9" Margin="2,0,2,0" MinHeight="90">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <CheckBox x:Name="LmxxfCheck" Content="lmxxf" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Top"/>
                      <Grid Grid.Row="2" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="LmxxfBadge" Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="LmxxfReason" FontSize="10" Foreground="{DynamicResource ThemeMuted}"/></Border>
                        <Button x:Name="LmxxfActiveBtn" Grid.Column="1" Style="{DynamicResource GhostButton}" Height="23" FontSize="10" Padding="7,0" Margin="5,0,0,0"/>
                        <TextBlock x:Name="LmxxfActiveLabel" Grid.Column="1" Foreground="{DynamicResource ThemeAccent}" FontSize="10" VerticalAlignment="Center" Visibility="Collapsed" Margin="5,0,0,0"/>
                      </Grid>
                      <TextBlock x:Name="LmxxfDescription" Grid.Row="1" FontSize="10" Foreground="{DynamicResource ThemeMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </Grid>
                  </Border>
                  <Border Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="10,9" Margin="5,0,0,0" MinHeight="90">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <CheckBox x:Name="DanielCheck" Content="Daniel" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Top"/>
                      <Grid Grid.Row="2" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="DanielBadge" Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="DanielReason" FontSize="10" Foreground="{DynamicResource ThemeMuted}"/></Border>
                        <Button x:Name="DanielActiveBtn" Grid.Column="1" Style="{DynamicResource GhostButton}" Height="23" FontSize="10" Padding="7,0" Margin="5,0,0,0"/>
                        <TextBlock x:Name="DanielActiveLabel" Grid.Column="1" Foreground="{DynamicResource ThemeAccent}" FontSize="10" VerticalAlignment="Center" Visibility="Collapsed" Margin="5,0,0,0"/>
                      </Grid>
                      <TextBlock x:Name="DanielDescription" Grid.Row="1" FontSize="10" Foreground="{DynamicResource ThemeMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </Grid>
                  </Border>
                </UniformGrid>
                <Border x:Name="ModelImportBar" Background="#26E3122B" BorderBrush="#E3122B" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,10,0,0" Visibility="Collapsed">
                  <DockPanel>
                    <Button x:Name="ModelImportButton" DockPanel.Dock="Right" Style="{DynamicResource GhostButton}" Background="#E3122B" Foreground="White" BorderBrush="#E3122B" Height="30" FontSize="11.5" FontWeight="SemiBold" Padding="14,0" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModelImportText" Foreground="{DynamicResource ThemeInk}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <TextBlock x:Name="BackendPackagePath" Foreground="{DynamicResource ThemeMuted}" FontSize="10" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Visibility="Collapsed"/>
                <TextBlock x:Name="MochiHint" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Margin="0,6,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="LmxxfHint" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Margin="0,3,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="DanielHint" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Margin="0,3,0,0" Visibility="Collapsed"/>
                <Expander x:Name="BackendDetails" Margin="0,6,0,0" Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Visibility="Collapsed"><StackPanel><TextBlock x:Name="BackendDetailsHeading"/><TextBlock x:Name="BackendDetailsText" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Expander>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}" Padding="15,12" Margin="0,12,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock x:Name="ProxyHeading" Text="注入代理" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center"/>
                  <!-- Hidden legacy ComboBox for protocol compatibility -->
                  <ComboBox x:Name="ProxyCombo" Visibility="Collapsed" Width="0" Height="0"/>
                </DockPanel>

                <TextBlock x:Name="InjectText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" FontSize="12" Margin="0,0,0,10"
                           Text="请从下方选择游戏启动时所加载的拦截代理 DLL："/>

                <!-- Horizontal Interactive Status Pills -->
                <WrapPanel x:Name="ProxyPillPanel">
                  <RadioButton x:Name="PillDxgi" Content="dxgi.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                  <RadioButton x:Name="PillD3d12" Content="d3d12.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                  <RadioButton x:Name="PillWinmm" Content="winmm.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                  <RadioButton x:Name="PillWinhttp" Content="winhttp.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                  <RadioButton x:Name="PillWininet" Content="wininet.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                  <RadioButton x:Name="PillDbghelp" Content="dbghelp.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                  <RadioButton x:Name="PillVersion" Content="version.dll" GroupName="ProxyPills" Style="{StaticResource PillRadio}"/>
                </WrapPanel>

                <!-- Recommendation Banner -->
                <Border x:Name="InjectBanner" Background="Transparent" Padding="0,2" Margin="0,4,0,0">
                  <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" x:Name="InjectIcon" Text="ℹ" Foreground="{DynamicResource ThemeSuccess}" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="InjectRecommendation" TextWrapping="Wrap" Text="选择游戏后将分析 PE 导入表并自动匹配推荐代理。" Foreground="{DynamicResource ThemeInk}" FontSize="10.5" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="UseRecommendationButton" Content="使用推荐" Style="{DynamicResource GhostButton}" Width="112" Height="30" Padding="0" Margin="0,0,8,0"/>
                  <Button x:Name="RefreshProfilesButton" Content="更新推荐资料" Style="{DynamicResource GhostButton}" Width="164" Height="30" Padding="0"/>
                  <TextBlock x:Name="ProfileStatus" FontSize="11" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}" Padding="15,12" Margin="0,12,0,16">
              <StackPanel>
                <DockPanel Margin="0,0,0,10"><Button x:Name="PackLogButton" DockPanel.Dock="Right" Style="{DynamicResource GhostButton}" Height="25" FontSize="10.5" Padding="8,0" VerticalAlignment="Center"/><TextBlock x:Name="DiagnosticsHeading" Foreground="{DynamicResource ThemeMuted}" FontSize="11.5" VerticalAlignment="Center"/></DockPanel>
                <TextBlock x:Name="CompatSummary" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Margin="0,0,0,9"/>
                <WrapPanel Margin="0,0,0,12"><Button x:Name="CompatButton" Style="{DynamicResource GhostButton}" Height="27" FontSize="11" IsEnabled="False"/><Button x:Name="RestoreCompatButton" Style="{DynamicResource GhostButton}" Height="27" FontSize="11" Margin="8,0,0,0" IsEnabled="False"/><Button x:Name="CompatHelpButton" Content="?" Style="{DynamicResource GhostButton}" Width="27" Height="27" Padding="0" Margin="8,0,0,0"/></WrapPanel>
                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,0,0,12"/>
                <TextBlock x:Name="InstallOptionsHeading" Foreground="{DynamicResource ThemeMuted}" FontSize="11" Margin="0,0,0,6"/>
                <CheckBox x:Name="ReplaceIni" IsChecked="True" FontSize="11" Margin="0,0,0,8"/>
                <CheckBox x:Name="OptiPatcherToggle" FontSize="11" Margin="0,0,0,12"/>
                <DockPanel Margin="0,0,0,12"><WrapPanel VerticalAlignment="Center"><TextBlock x:Name="PluginHeading" Foreground="{DynamicResource ThemeMuted}" FontSize="11" VerticalAlignment="Center"/><Button x:Name="UnlockerImportButton" Style="{DynamicResource GhostButton}" Height="27" Padding="8,0" FontSize="11" Margin="12,0,8,0" Visibility="Collapsed"/><Button x:Name="OpenPluginsFolderButton" Style="{DynamicResource GhostButton}" Height="27" Padding="8,0" FontSize="11" Margin="4,0,8,0" Visibility="Collapsed" IsEnabled="False"/></WrapPanel></DockPanel>
                <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,0,0,12"/>
                <Border Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="10">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="IniFolderButton" Style="{DynamicResource GhostButton}" Height="25" FontSize="10.5" Padding="8,0"/><Button x:Name="IniSaveButton" Style="{DynamicResource GhostButton}" Height="25" FontSize="10.5" Padding="8,0" Margin="5,0,0,0"/><Button x:Name="IniImportButton" Style="{DynamicResource GhostButton}" Height="25" FontSize="10.5" Padding="8,0" Margin="5,0,0,0"/><Button x:Name="IniApplyButton" Style="{DynamicResource GhostButton}" Height="25" FontSize="10.5" Padding="12,0" Margin="5,0,0,0"/></StackPanel><TextBlock x:Name="IniHeading" Foreground="{DynamicResource ThemeMuted}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="IniProfileCombo" Height="30"/><TextBox x:Name="IniSearchBox" Grid.Column="1" Height="30" Margin="6,0,0,0" Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeInk}" BorderBrush="{DynamicResource ThemeBorder}" Padding="8,5"/><Button x:Name="IniRenameButton" Grid.Column="2" Style="{DynamicResource GhostButton}" Height="30" Padding="8,0" FontSize="10.5" Margin="6,0,0,0"/><Button x:Name="IniDeleteButton" Grid.Column="3" Style="{DynamicResource GhostButton}" Height="30" Padding="8,0" FontSize="10.5" Margin="6,0,0,0"/></Grid>
                    <DockPanel Margin="0,8,0,0"><Button x:Name="IniQuickSaveButton" Style="{DynamicResource GhostButton}" Height="25" FontSize="10.5" Padding="8,0" Margin="0,0,10,0"/><TextBlock x:Name="IniSelectHint" Foreground="{DynamicResource ThemeMuted}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
                    <Border x:Name="StyleShareBar" Background="{DynamicResource ThemeSubtle}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,10,0,0">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button x:Name="StyleOutButton" Style="{DynamicResource GhostButton}" Height="30" FontSize="11.5" Padding="12,0" Margin="6,0,0,0"/>
                          <Button x:Name="StyleInButton" Style="{DynamicResource GhostButton}" Background="{DynamicResource ThemeAccent}" BorderThickness="0" Foreground="White" Height="30" FontSize="11.5" FontWeight="SemiBold" Padding="12,0" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock x:Name="StyleShareTitle" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource ThemeInk}"/>
                          <TextBlock x:Name="StyleShareSub" FontSize="10" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" Margin="0,2,8,0"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <TextBlock x:Name="IniProfileStatus" Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
                <Expander Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" Margin="0,10,0,0"><Expander.Header><TextBlock x:Name="LogHeading"/></Expander.Header><StackPanel><Button x:Name="OpenLogButton" Style="{DynamicResource GhostButton}" HorizontalAlignment="Right" Margin="0,8"/><TextBox x:Name="LogView" Height="100" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource ThemeSubtle}" Foreground="{DynamicResource ThemeMuted}" BorderBrush="{DynamicResource ThemeBorder}" Padding="6" FontSize="11" FontFamily="Consolas, Segoe UI"/></StackPanel></Expander>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border x:Name="SettingsPage" VerticalAlignment="Bottom" MaxHeight="330" Visibility="Collapsed" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="22,14" Panel.ZIndex="5">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <DockPanel Margin="0,0,0,12"><Button x:Name="SettingsCloseButton" DockPanel.Dock="Right" Style="{DynamicResource GhostButton}" Height="25" Padding="10,0"/><TextBlock x:Name="SettingsHeading" Foreground="{DynamicResource ThemeMuted}" FontSize="12" VerticalAlignment="Center"/></DockPanel>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LanguageHeading" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><ComboBox x:Name="LangCombo" Width="150" Height="30"/><TextBlock x:Name="ThemeHeading" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" Margin="24,0,12,0"/><ComboBox x:Name="ThemeCombo" Width="150" Height="30"/></WrapPanel>
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,15" VerticalAlignment="Center"><CheckBox x:Name="ScanOnStartup" FontSize="12" VerticalAlignment="Center"/><Button x:Name="DiagnosticModeButton" Style="{DynamicResource GhostButton}" Height="28" FontSize="11" Margin="18,0,0,0"/></WrapPanel>
