                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Border x:Name="OpenRrNoDlssdWarningBadge" Style="{StaticResource Badge}" Margin="0,0,8,0" Visibility="Collapsed">
                          <TextBlock x:Name="OpenRrNoDlssdWarningBadgeText" Text="未检测到原生 DLSSD" FontSize="11" Foreground="{DynamicResource ThemeMuted}"/>
                        </Border>
                        <Button x:Name="RelockOpenRrBtn" Style="{DynamicResource CardAction}" Margin="0,0,8,0" Content="重新锁定" Visibility="Collapsed"
                                local:DialogTheme.Icon="M 3.75 7.25 H 12.25 V 13.75 H 3.75 Z M 5.5 7.25 V 5 A 2.5 2.5 0 0 1 10.5 5 V 7.25"/>
                        <Border x:Name="OpenRrBadge" Style="{StaticResource Badge}">
                          <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Margin="0,0,5,0" Fill="{Binding Foreground, ElementName=OpenRrStatusText}"/><TextBlock x:Name="OpenRrStatusText" FontSize="11" Foreground="{DynamicResource ThemeMuted}"/></StackPanel>
                        </Border>
                      </StackPanel>
                      <CheckBox x:Name="OpenRrToggle" Style="{DynamicResource ToggleSwitch}" IsChecked="False" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="OpenRrDescription" Style="{StaticResource Caption}" Margin="52,6,0,0"/>
                    <TextBlock x:Name="OpenRrNoDlssdWarningText" FontSize="12" Foreground="{DynamicResource ThemeMuted}" Margin="52,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <CheckBox x:Name="OpenRrAutoSpoofToggle" Style="{DynamicResource ToggleSwitch}" IsChecked="False" FontSize="12" Foreground="{DynamicResource ThemeMuted}" Margin="52,12,0,0" Visibility="Collapsed" ToolTipService.ShowOnDisabled="True"/>
                  </StackPanel>
                </Border>
                <Border x:Name="OpenRrCollapsedBar" Style="{StaticResource InfoBar}" Margin="0,8,0,0" Visibility="Collapsed">
                  <DockPanel>
                    <Button x:Name="SwitchToOptiScalerBtn" DockPanel.Dock="Right" Style="{DynamicResource CardAction}" Margin="12,0,0,0" VerticalAlignment="Center" Content="切回 OptiScaler"/>
