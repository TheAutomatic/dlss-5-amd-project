                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" SharedSizeGroup="ProfileApply"/><ColumnDefinition Width="Auto" SharedSizeGroup="ProfileMore"/></Grid.ColumnDefinitions>
