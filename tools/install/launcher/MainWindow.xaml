                      <RadioButton x:Name="GameBitnessAutoRadio" Content="自动" GroupName="GameBitness" Style="{StaticResource PillRadio}" IsChecked="True"/>
                      <RadioButton x:Name="GameBitness32Radio" Content="32 位" GroupName="GameBitness" Style="{StaticResource PillRadio}"/>
                      <RadioButton x:Name="GameBitness64Radio" Content="64 位" GroupName="GameBitness" Style="{StaticResource PillRadio}"/>
                    </WrapPanel>
                    <TextBlock x:Name="ReshadeApiLabel" Text="图形接口路线（API）" FontSize="12" Foreground="{DynamicResource ThemeMuted}" Margin="0,0,0,8"/>
