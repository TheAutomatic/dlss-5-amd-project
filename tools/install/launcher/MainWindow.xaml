                        <TextBlock x:Name="WikiDetailsText" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"><Hyperlink x:Name="WikiDetailsLink" Foreground="{DynamicResource ThemeInk}"/></TextBlock>
                        <TextBlock x:Name="InjectRecommendation" TextWrapping="Wrap" Text="选择游戏后将分析 PE 导入表并自动匹配推荐代理。" Foreground="{DynamicResource ThemeInk}" FontSize="12" LineHeight="18" VerticalAlignment="Center"/>
                      </DockPanel>
                    </Border>
                    <WrapPanel Margin="0,12,0,0">
                      <Button x:Name="UseRecommendationButton" Content="使用推荐" Style="{DynamicResource CardAction}" Margin="0,0,8,0"
                              local:DialogTheme.Icon="M 3.5 8.5 L 6.5 11.5 L 12.5 4.5"/>
                      <Button x:Name="RefreshProfilesButton" Content="更新推荐资料" Style="{DynamicResource CardAction}"
                              local:DialogTheme.Icon="M 13.25 8 A 5.25 5.25 0 1 1 11.71 4.29 M 12.25 1.75 V 4.75 H 9.25"/>
                      <TextBlock x:Name="ProfileStatus" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </WrapPanel>
                    </StackPanel>
                  </StackPanel>
              </StackPanel>
            </Border>
            </StackPanel>

            <!-- ===== Standalone ===== -->
            <Border x:Name="StandaloneModeCard" Background="Transparent" Margin="0,28,0,0" Visibility="Collapsed">
              <StackPanel>
