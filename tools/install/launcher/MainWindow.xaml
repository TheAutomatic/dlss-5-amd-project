                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock x:Name="StandaloneCardDesc" Text="直接部署 dxgi.dll + dlssnr-amd.asi + vulkan-1.dll 与 Vulkan 隐式层（vk-override），在 Present 阶段以无向导 RenoDX 模式运行。无需游戏内置 DLSS/FSR/XeSS，适合视频播放器（mpv/PotPlayer/VLC）、OBS、Magpie 或各类 DirectX 11/12/Vulkan 程序。" FontSize="12" Foreground="{DynamicResource ThemeInk}" TextWrapping="Wrap" LineHeight="19"/>
                    <Border Height="1" Background="{DynamicResource ThemeHairline}" Margin="0,12"/>
                    <TextBlock x:Name="StandaloneHotkeysText" Text="快捷键：End 打开 NR Control 面板 · F6 开关 NR · F5 截图保存至 NR Screenshots · Ctrl+F11 切换网络" FontSize="12" Foreground="{DynamicResource ThemeInk}" TextWrapping="Wrap"/>
