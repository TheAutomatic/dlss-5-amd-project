                        <Button x:Name="AsiProfileDeleteButton" Style="{DynamicResource SubtleButton}" HorizontalContentAlignment="Left"/>
                        <Button x:Name="AsiProfileFolderButton" Style="{DynamicResource SubtleButton}" HorizontalContentAlignment="Left"/>
                      </StackPanel>
                    </Border>
                  </Popup>
                  <Border Height="1" Background="{DynamicResource ThemeHairline}" Margin="0,8"/>
