                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="ProfileLabel"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="OptiScalerConfigHeading" Foreground="{DynamicResource ThemeInk}" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                  <StackPanel x:Name="ProfilesCardBody" Grid.Column="1">
