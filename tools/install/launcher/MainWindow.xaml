<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:OptScalerNR.Launcher;assembly=OptiScalerNRLauncher"
        Title="OptiScaler NR - 本软件免费，如付费购买请立即退款！"
        Width="1240" Height="800"
        MinWidth="1020" MinHeight="660"
        Background="{DynamicResource ThemeCanvas}"
        Foreground="{DynamicResource ThemeInk}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        BorderBrush="{DynamicResource ThemeBorder}"
        BorderThickness="1"
        AllowDrop="True">
  <!-- GlassFrameThickness 0,0,0,1 keeps the native DWM shadow without a visible glass strip.
       NativeFrame upgrades this to a full Mica frame on Windows 11 22H2+ (see LauncherTheme.cs). -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48"
                  ResizeBorderThickness="6"
                  CornerRadius="0"
                  GlassFrameThickness="0,0,0,1"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- ComboBox chrome is duplicated locally so LibraryFilter's BasedOn resolves while this file is parsed. -->
    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
      <Border x:Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
          <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="6" Stretch="None" Stroke="{DynamicResource ThemeMuted}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0.5 0.5 L 5 5 L 9.5 0.5"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="true">
          <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeControlHover}"/>
          <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource ThemeInk}"/>
        </Trigger>
        <Trigger Property="IsChecked" Value="true">
          <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeControlPressed}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Background" Value="{DynamicResource ThemeControl}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="11,0,30,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="true"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="false"
                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>
              <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade">
                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border x:Name="DropDownBorder" Background="{DynamicResource ThemeCardBg}" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorder}" CornerRadius="8" Margin="6,4,6,10">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.16"/></Border.Effect>
                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                      <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="SnapsToDevicePixels" Value="true"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Grid>
              <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent" SnapsToDevicePixels="true">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="Bar" Width="3" Height="14" CornerRadius="1.5" HorizontalAlignment="Left" Background="{DynamicResource ThemeAccent}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="true"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger>
              <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHover}"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LibraryFilter" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Background" Value="{DynamicResource ThemeControl}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}"/>
    </Style>
    <Style x:Key="LibraryFilterItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}"/>
      <Setter Property="Margin" Value="1"/>
    </Style>

    <!-- Single-layer card: the only framed surface level in the details pane. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeHairline}"/>
      <Setter Property="BorderThickness" Value="{DynamicResource ThemeCardBorderThickness}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>
    <Style x:Key="Surface" TargetType="Border" BasedOn="{StaticResource Card}"/>
    <!-- Informational strip inside a card (lock notices, import prompts). -->
    <Style x:Key="InfoBar" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeHairline}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Low-saturation status badge. -->
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeHairline}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Proxy / API chips. -->
    <Style x:Key="PillRadio" TargetType="{x:Type RadioButton}">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Grid x:Name="Body">
              <Border x:Name="PillBorder" CornerRadius="15" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Background="{DynamicResource ThemeControl}"/>
              <Border x:Name="Hover" CornerRadius="15" Background="{DynamicResource ThemeInk}" Opacity="0" IsHitTestVisible="False"/>
              <StackPanel x:Name="Label" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,6,14,6">
                <Ellipse x:Name="Indicator" Width="6" Height="6" Fill="{DynamicResource ThemeFaint}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center" TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="{TemplateBinding FontSize}"/>
              </StackPanel>
              <Border x:Name="KeyboardRing" Margin="-3" CornerRadius="18" BorderThickness="2" BorderBrush="{DynamicResource ThemeInk}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="true">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="true">
                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBorder}"/>
                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                <Setter TargetName="Indicator" Property="Fill" Value="{DynamicResource ThemeAccent}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Label" Property="Opacity" Value="0.75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Installation mode card: soft accent fill + thin border + 3px left indicator when selected. -->
    <Style x:Key="ModeCardRadio" TargetType="{x:Type RadioButton}">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Grid x:Name="CardRoot">
              <Border x:Name="CardBorder" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" CornerRadius="8" Padding="16,13,14,13" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
              </Border>
              <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource ThemeInk}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="Indicator" Width="3" CornerRadius="1.5" Margin="0,14" HorizontalAlignment="Left" Background="{DynamicResource ThemeAccent}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="KeyboardRing" Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource ThemeInk}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.035" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBorder}"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CardRoot" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Win11 caption buttons: 46px wide, vector glyphs in a 10x10 box (local:DialogTheme.Icon). -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"/>
              <Border x:Name="Hover" Background="{TemplateBinding Foreground}" Opacity="0"/>
              <Path x:Name="Glyph" Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"
                    Data="{Binding Path=(local:DialogTheme.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                    Stroke="{TemplateBinding Foreground}" StrokeThickness="1"/>
              <Border x:Name="KeyboardRing" Margin="2" BorderThickness="2" BorderBrush="{DynamicResource ThemeInk}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.07"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.04"/><Setter TargetName="Glyph" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="Bd" Background="{TemplateBinding Background}"/>
              <Path x:Name="Glyph" Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="{Binding Path=(local:DialogTheme.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                    Stroke="{TemplateBinding Foreground}" StrokeThickness="1"/>
              <Border x:Name="KeyboardRing" Margin="2" BorderThickness="2" BorderBrush="{DynamicResource ThemeInk}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeCloseHover}"/>
                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource ThemeOnAccent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeClosePressed}"/>
                <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource ThemeOnAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GameContextMenu" TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="6,2,6,10">
              <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.16"/></Border.Effect>
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GameContextMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinWidth" Value="180"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="MenuItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="0,1">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource ThemeHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ThemeFaint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GameContextMenuSeparator" TargetType="Separator">
      <Setter Property="Margin" Value="6,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="{DynamicResource ThemeHairline}" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Game library rows: subtle fill + 3px accent pill on the selected row (NavigationView style). -->
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeInk}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True"/>
              <Border x:Name="Hover" Background="{DynamicResource ThemeInk}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="Accent" Background="{DynamicResource ThemeAccent}" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Visibility="Collapsed"/>
              <ContentPresenter Margin="10,7,8,7"/>
              <Border x:Name="KeyboardRing" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource ThemeInk}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="local:DialogTheme.KeyboardFocusVisible" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="true">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.045" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSelected}"/>
                <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="RootLayout" Background="{DynamicResource ThemeCanvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="32"/>
    </Grid.RowDefinitions>

    <!-- ===== Title bar ===== -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,12,0">
        <Image x:Name="AppTitleIcon" Width="24" Height="24" Margin="0,0,10,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
        <TextBlock Text="OptiScaler NR" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Border x:Name="VersionBadge" VerticalAlignment="Center" Background="Transparent" Margin="8,1,0,0">
          <TextBlock x:Name="VersionTag" FontSize="11.5" Foreground="{DynamicResource ThemeFaint}" Text="2.0.0" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="PageTitle" Visibility="Collapsed"/>
      </StackPanel>

      <!-- Search -->
      <Border Grid.Column="1" Height="32" MinWidth="180" MaxWidth="420" HorizontalAlignment="Stretch" Margin="24,0" CornerRadius="6"
              Background="{DynamicResource ThemeControl}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1" WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid Margin="10,0,8,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Path Width="16" Height="16" Stretch="None" VerticalAlignment="Center" Stroke="{DynamicResource ThemeMuted}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M 2.25 6.75 A 4.5 4.5 0 1 1 11.25 6.75 A 4.5 4.5 0 1 1 2.25 6.75 Z M 10.1 10.1 L 13.75 13.75"/>
          <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource ThemeFaint}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Text="搜索游戏或程序路径">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBox x:Name="SearchBox" Grid.Column="1" Margin="6,0,0,0" Background="Transparent" Foreground="{DynamicResource ThemeInk}" CaretBrush="{DynamicResource ThemeInk}"
                   BorderThickness="0" VerticalContentAlignment="Center" FontSize="12.5" WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBox.Template>
              <ControlTemplate TargetType="TextBox">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" Background="Transparent"/>
              </ControlTemplate>
            </TextBox.Template>
          </TextBox>
        </Grid>
      </Border>

      <!-- Tools -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
        <Button x:Name="RefreshButton" Style="{DynamicResource IconButton}" local:DialogTheme.Icon="M 13.25 8 A 5.25 5.25 0 1 1 11.71 4.29 M 12.25 1.75 V 4.75 H 9.25" Margin="0,0,2,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Border Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="LangZh" Style="{DynamicResource SubtleButton}" Width="32" Height="24" MinHeight="24" Padding="0" FontSize="12" WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="LangEn" Content="EN" Style="{DynamicResource SubtleButton}" Width="32" Height="24" MinHeight="24" Padding="0" FontSize="12" WindowChrome.IsHitTestVisibleInChrome="True"/>
          </StackPanel>
        </Border>
        <Button x:Name="LangToggle" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="ThemeToggle" Style="{DynamicResource IconButton}" Margin="2,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="SettingsTab" Style="{DynamicResource IconButton}" Margin="2,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True"
                local:DialogTheme.Icon="M 2.5 4.5 H 5.5 M 9.5 4.5 H 13.5 M 7.5 2.75 A 1.75 1.75 0 1 1 7.5 6.25 A 1.75 1.75 0 1 1 7.5 2.75 Z M 2.5 11.5 H 7.5 M 11.5 11.5 H 13.5 M 9.5 9.75 A 1.75 1.75 0 1 1 9.5 13.25 A 1.75 1.75 0 1 1 9.5 9.75 Z"/>
        <Button x:Name="LibraryTab" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True"/>
      </StackPanel>

      <!-- Caption -->
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="MinBtn" Style="{StaticResource CaptionButton}" local:DialogTheme.Icon="M 0 5.5 H 10" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" local:DialogTheme.Icon="M 1.5 0.5 H 8.5 A 1 1 0 0 1 9.5 1.5 V 8.5 A 1 1 0 0 1 8.5 9.5 H 1.5 A 1 1 0 0 1 0.5 8.5 V 1.5 A 1 1 0 0 1 1.5 0.5 Z" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="CloseBtn" Style="{StaticResource CloseCaptionButton}" local:DialogTheme.Icon="M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5" WindowChrome.IsHitTestVisibleInChrome="True"/>
      </StackPanel>
    </Grid>

    <!-- ===== Body: library sidebar + details layer ===== -->
    <Grid x:Name="LibraryPage" Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <DockPanel Background="{DynamicResource ThemeSidebar}">
        <Grid DockPanel.Dock="Top" Margin="18,6,10,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="LocalGamesHeading" Text="游戏库" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
          <Border x:Name="CountBadgeBorder" Grid.Column="1" Background="Transparent" Margin="8,1,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="CountBadge" FontSize="12" Foreground="{DynamicResource ThemeFaint}"/>
          </Border>
          <Button x:Name="AddMenuButton" Grid.Column="3" Style="{DynamicResource SubtleButton}" Height="30" Padding="8,0,10,0" FontSize="12.5"
                  local:DialogTheme.Icon="M 8 3 V 13 M 3 8 H 13"/>
          <Popup x:Name="AddMenuPopup" PlacementTarget="{Binding ElementName=AddMenuButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="6,4,10,12" MinWidth="250">
              <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.18"/></Border.Effect>
              <StackPanel>
                <Button x:Name="AddButton" Style="{DynamicResource SubtleButton}" HorizontalContentAlignment="Left" Height="34" Padding="10,0" FontSize="12.5" Margin="0,0,0,2"
                        local:DialogTheme.Icon="M 4 1.75 H 9.5 L 12.5 4.75 V 14.25 H 4 Z M 9.5 1.75 V 4.75 H 12.5 M 8.25 7.5 V 12 M 6 9.75 H 10.5"/>
                <Button x:Name="AddFolderButton" Style="{DynamicResource SubtleButton}" HorizontalContentAlignment="Left" Height="34" Padding="10,0" FontSize="12.5" Margin="0,0,0,2"
                        local:DialogTheme.Icon="M 1.75 4.25 A 1 1 0 0 1 2.75 3.25 H 6 L 7.5 4.75 H 13.25 A 1 1 0 0 1 14.25 5.75 V 12 A 1 1 0 0 1 13.25 13 H 2.75 A 1 1 0 0 1 1.75 12 Z"/>
                <Button x:Name="AddRtxRemixMcButton" Style="{DynamicResource SubtleButton}" HorizontalContentAlignment="Left" Height="34" Padding="10,0" FontSize="12.5"
                        local:DialogTheme.Icon="M 2.5 4.75 L 8 2.25 L 13.5 4.75 V 11.25 L 8 13.75 L 2.5 11.25 Z M 2.5 4.75 L 8 7.25 L 13.5 4.75 M 8 7.25 V 13.75"/>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>
        <ComboBox x:Name="FilterCombo" DockPanel.Dock="Top" Style="{StaticResource LibraryFilter}" ItemContainerStyle="{StaticResource LibraryFilterItem}" Margin="14,0,14,8" Height="30" FontSize="12"/>
        <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0" Margin="8,0,6,8" Padding="0,0,4,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <!-- Keep the sidebar surface when installation disables game selection. -->
          <ListBox.Template>
            <ControlTemplate TargetType="{x:Type ListBox}">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="true">
                <ScrollViewer x:Name="PART_ScrollViewer" Focusable="false" Padding="{TemplateBinding Padding}">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </ScrollViewer>
              </Border>
            </ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Cover / icon with a fine inner stroke; monogram fallback. -->
                <Grid Width="40" Height="40" VerticalAlignment="Center">
                  <Border CornerRadius="6" Background="{DynamicResource ThemeCardBg}">
                    <Border.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="6" RadiusY="6"/></Border.Clip>
                    <Grid>
                      <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" Foreground="{DynamicResource ThemeMuted}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Image Source="{Binding DisplayImage}" Visibility="{Binding CoverVisibility}" Stretch="{Binding ImageStretch}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                  </Border>
                  <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ThemeHairline}" IsHitTestVisible="False"/>
                </Grid>
                <!-- Line 1: full-width name. Line 2: source tag + status dot. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,2,0">
                  <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeInk}" ToolTip="{Binding Name}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding SourceText}" FontSize="10.5" Foreground="{DynamicResource ThemeMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="96"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{Binding StatusExplanation}">
                      <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,1,5,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource ThemeMuted}" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Details layer: rounded top-left corner + hairline separates it from the sidebar (Win11 Settings). -->
      <Border Grid.Column="1" Background="{DynamicResource ThemeLayer}" BorderBrush="{DynamicResource ThemeHairline}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" ClipToBounds="True">
        <ScrollViewer x:Name="DetailsScroll" Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24,20,20,28">

            <!-- ===== Hero ===== -->
            <Border x:Name="HeroCard" CornerRadius="8" Height="186" Background="{DynamicResource ThemeHeroBg}" BorderBrush="{DynamicResource ThemeHeroBg}" BorderThickness="1" ClipToBounds="True">
              <Grid>
                <Image x:Name="HeroBgImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" CacheMode="BitmapCache" IsHitTestVisible="False">
                  <Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00000000" Offset="0.2"/><GradientStop Color="#B3000000" Offset="0.62"/><GradientStop Color="#FF000000" Offset="1"/></LinearGradientBrush></Image.OpacityMask>
                </Image>
                <!-- Theme-coloured scrim keeps title text readable over artwork in both light and dark. -->
                <Border Background="{DynamicResource ThemeHeroBg}" IsHitTestVisible="False">
                  <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F2000000" Offset="0"/><GradientStop Color="#B3000000" Offset="0.42"/><GradientStop Color="#00000000" Offset="0.85"/></LinearGradientBrush></Border.OpacityMask>
                </Border>
                <Grid Margin="24,20,20,16">
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="HeroKicker" Foreground="{DynamicResource ThemeHeroMuted}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeroTitle" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource ThemeHeroInk}" Margin="0,4,0,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="HeroMeta" Foreground="{DynamicResource ThemeHeroMuted}" FontSize="12" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeroPath" Foreground="{DynamicResource ThemeHeroMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                  </StackPanel>
                  <Button x:Name="PrimaryButton" Grid.Column="1" Style="{DynamicResource PrimaryButton}" Height="40" MinWidth="196" MaxWidth="300" VerticalAlignment="Center" Padding="20,0" IsEnabled="False"/>
                  <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0" LastChildFill="False">
                    <Button x:Name="LaunchGameButton" Style="{DynamicResource HeroButton}" Height="30" Padding="10,0,12,0" IsEnabled="False"
                            local:DialogTheme.Icon="M 5 3.25 L 12.5 8 L 5 12.75 Z"/>
                    <Button x:Name="ManageGameButton" Style="{DynamicResource HeroButton}" Height="30" Padding="10,0,12,0" Margin="8,0,0,0" IsEnabled="False"
                            local:DialogTheme.Icon="M 10.5 2.5 L 13.5 5.5 L 5.5 13.5 H 2.5 V 10.5 Z M 9 4 L 12 7"/>
                    <Button x:Name="OpenFolderButton" Style="{DynamicResource HeroButton}" Height="30" Padding="10,0,12,0" Margin="8,0,0,0"
                            local:DialogTheme.Icon="M 1.75 4.25 A 1 1 0 0 1 2.75 3.25 H 6 L 7.5 4.75 H 13.25 A 1 1 0 0 1 14.25 5.75 V 12 A 1 1 0 0 1 13.25 13 H 2.75 A 1 1 0 0 1 1.75 12 Z"/>
                    <Button x:Name="PackLogButton" Style="{DynamicResource HeroButton}" Height="30" Padding="10,0,12,0" Margin="8,0,0,0"
                            local:DialogTheme.Icon="M 2.5 4.75 L 8 2.25 L 13.5 4.75 V 11.25 L 8 13.75 L 2.5 11.25 Z M 2.5 4.75 L 8 7.25 L 13.5 4.75 M 8 7.25 V 13.75"/>
                    <Border Width="1" Height="18" Background="{DynamicResource ThemeHairline}" Margin="14,0,6,0" VerticalAlignment="Center"/>
                    <Button x:Name="UninstallButton" Style="{DynamicResource HeroButton}" Height="30" Padding="8,0,10,0" IsEnabled="False"
                            local:DialogTheme.Icon="M 2.5 4.25 H 13.5 M 6 4.25 V 2.75 H 10 V 4.25 M 4 4.25 L 4.75 13.5 H 11.25 L 12 4.25 M 6.75 6.75 V 11 M 9.25 6.75 V 11"/>
                  </DockPanel>
                </Grid>
                <ProgressBar x:Name="Progress" Height="3" VerticalAlignment="Bottom" Foreground="{DynamicResource ThemeHeroMuted}" Background="Transparent" BorderThickness="0"/>
                <Grid Visibility="Collapsed"><TextBlock x:Name="HeroPosterInitial"/><Image x:Name="HeroPosterImage"/><TextBlock x:Name="HeroMonogram"/></Grid>
              </Grid>
            </Border>

            <!-- ===== Installation mode ===== -->
            <Border x:Name="InstallModeSection" Background="Transparent" Margin="0,28,0,0">
              <StackPanel>
                <DockPanel Margin="2,0,0,10">
                  <Border x:Name="ModeDetectBadge" DockPanel.Dock="Right" Style="{StaticResource Badge}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Margin="0,0,5,0" Fill="{Binding Foreground, ElementName=ModeDetectText}"/><TextBlock x:Name="ModeDetectText" FontSize="11" Foreground="{DynamicResource ThemeMuted}"/></StackPanel>
                  </Border>
                  <TextBlock x:Name="InstallModeHeading" Text="安装模式" Style="{StaticResource SectionHeader}"/>
                </DockPanel>
                <UniformGrid x:Name="ModeCardsGrid" Columns="3">
                  <RadioButton x:Name="ModeOptiScalerRadio" GroupName="InstallMode" Style="{StaticResource ModeCardRadio}" Margin="0,0,6,0" IsChecked="True">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,5">
                        <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                          <TextBlock x:Name="ModeOptiTag" Text="推荐" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeSuccess}"/>
                        </Border>
                        <TextBlock x:Name="ModeOptiTitle" Text="OptiScaler（默认）" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <TextBlock x:Name="ModeOptiDesc" Text="DLSS / FSR / XeSS 现代游戏 · 支持 OpenRR / OptiPatcher" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="ModeStandaloneRadio" GroupName="InstallMode" Style="{StaticResource ModeCardRadio}" Margin="3,0,3,0">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,5">
                        <Border DockPanel.Dock="Right" Visibility="Collapsed">
                          <TextBlock x:Name="ModeStandaloneTag" Text="直通" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMuted}"/>
                        </Border>
                        <TextBlock x:Name="ModeStandaloneTitle" Text="独立直通（Standalone）" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <TextBlock x:Name="ModeStandaloneDesc" Text="DX11/12 / Vulkan · 视频 / OBS / 任意程序 · 免超分接管" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="ModeReShadeRadio" GroupName="InstallMode" Style="{StaticResource ModeCardRadio}" Margin="6,0,0,0">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,5">
                        <Border DockPanel.Dock="Right" Visibility="Collapsed">
                          <TextBlock x:Name="ModeReShadeTag" Text="经典兼容" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMuted}"/>
                        </Border>
                        <TextBlock x:Name="ModeReShadeTitle" Text="ReShade 兼容模式" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ThemeInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <TextBlock x:Name="ModeReShadeDesc" Text="DX9 (DXVK) / DX10-12 / Vulkan 老游戏 · 支持 LumeniteFX" FontSize="11.5" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" LineHeight="17"/>
                    </StackPanel>
                  </RadioButton>
                </UniformGrid>
                <TextBlock x:Name="GameBitnessRestriction" Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                <!-- RTX Remix MC instances only have one mode: shown as the (selected) card, without a red frame. -->
                <Border x:Name="RtxRemixMcModeCard" Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccentBorder}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                  <Grid>
                    <Border Width="3" CornerRadius="1.5" Margin="0,14" HorizontalAlignment="Left" Background="{DynamicResource ThemeAccent}"/>
                    <StackPanel Margin="16,13,14,13">
                      <DockPanel Margin="0,0,0,6">
                        <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                          <TextBlock x:Name="RtxRemixMcTag" Text="专用模式" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeSuccess}"/>
                        </Border>
                        <TextBlock x:Name="RtxRemixMcTitle" Text="RTX Remix for Minecraft（Java 版）" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource ThemeInk}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <TextBlock x:Name="RtxRemixMcDesc" Text="自动向 remix-sdk\ 原名部署 OptiScaler.dll 与 AMD 兼容版 remixbridge.dll（自动备份 NVIDIA 原版，完整卸载可无损还原），并自动启用 VulkanExtensionSpoofing = true。建议使用 OpenRR 光线重建；Mochizuki 神经渲染默认锁定且不建议用于 MC。" FontSize="12" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border x:Name="ModeSwitchNotice" Margin="2,10,0,0" Visibility="Collapsed">
                  <DockPanel><TextBlock Text="ℹ" Foreground="{DynamicResource ThemeMuted}" Margin="0,0,8,0"/><TextBlock x:Name="ModeSwitchNoticeText" Foreground="{DynamicResource ThemeMuted}" FontSize="12" TextWrapping="Wrap"/></DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- ===== ASI plugins ===== -->
            <Border x:Name="BackendSection" Background="Transparent" Margin="0,28,0,0">
              <StackPanel>
                <DockPanel Margin="2,0,0,10">
                  <Button x:Name="RefreshBackendsButton" DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Width="30" Height="28" Foreground="{DynamicResource ThemeMuted}"
                          local:DialogTheme.Icon="M 13.25 8 A 5.25 5.25 0 1 1 11.71 4.29 M 12.25 1.75 V 4.75 H 9.25"/>
                  <TextBlock x:Name="BackendsHeading" Style="{StaticResource SectionHeader}"/>
                </DockPanel>
                <Grid>
                  <Border x:Name="MochiCard" Style="{StaticResource Card}">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                          <Border x:Name="MochiRequiredBadge" Style="{StaticResource Badge}" Margin="0,0,8,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Margin="0,0,5,0" Fill="{Binding Foreground, ElementName=MochiRequiredText}"/><TextBlock x:Name="MochiRequiredText" Text="当前模式必选" FontSize="11" Foreground="{DynamicResource ThemeMuted}"/></StackPanel>
                          </Border>
                          <Border x:Name="MochiMcWarningBadge" Style="{StaticResource Badge}" Margin="0,0,8,0" Visibility="Collapsed">
                            <TextBlock x:Name="MochiMcWarningBadgeText" Text="不建议用于 MC" FontSize="11" Foreground="{DynamicResource ThemeMuted}"/>
                          </Border>
                          <Button x:Name="RelockMochiMcBtn" Style="{DynamicResource CardAction}" Margin="0,0,8,0" Content="重新锁定" Visibility="Collapsed"
