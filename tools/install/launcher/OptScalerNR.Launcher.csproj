    <Reference Include="PresentationCore"/><Reference Include="PresentationFramework"/><Reference Include="System.Drawing"/><Reference Include="System.IO.Compression"/><Reference Include="System.IO.Compression.FileSystem"/>
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets"/>
</Project>
