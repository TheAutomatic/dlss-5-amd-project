    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <FrameworkPathOverride>C:\Windows\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs"/>
    <Compile Include="MainWindow.cs"/>
    <Compile Include="Protocol.cs"/>
    <Compile Include="WorkerClient.cs"/>
    <Compile Include="GamePaths.cs"/>
    <Compile Include="DialogTheme.cs"/>
    <Compile Include="FolderGameScanner.cs"/>
    <Compile Include="ProxyRecommendations.cs"/>
    <Compile Include="MainController.Library.cs"/>
    <Compile Include="MainController.Recommendations.cs"/>
    <Compile Include="LauncherTheme.cs"/>
    <Compile Include="MainController.Presentation.cs"/>
    <Compile Include="MainController.Profiles.cs"/>
    <Compile Include="MainController.UnlockerPlugin.cs"/>
    <Compile Include="UnlockerPlugin.cs"/>
    <Compile Include="MainController.ShareCode.cs"/>
    <Compile Include="MainController.ModelImport.cs" />
    <Compile Include="MochizukiShareCode.cs"/>
    <Compile Include="MainController.Diagnostics.cs"/>
    <Compile Include="MainController.LogPack.cs"/>
    <Compile Include="IniProfiles.cs"/>
    <Compile Include="LocalArtwork.cs"/>
